{
  "manifest_version": 3,
  "name": "Chrome VCAM - Virtual Camera Injector",
  "version": "1.2.0",
  "description": "Giả lập webcam chuẩn Desktop 16:9 cho trang web xác thực KYC",
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "ui.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}