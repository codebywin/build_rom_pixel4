diff --git a/core/java/android/hardware/camera2/impl/VcamEngine.java b/core/java/android/hardware/camera2/impl/VcamEngine.java
new file mode 100644
--- /dev/null
+++ b/core/java/android/hardware/camera2/impl/VcamEngine.java
@@ -0,0 +1,180 @@
+package android.hardware.camera2.impl;
+
+import android.graphics.SurfaceTexture;
+import android.hardware.camera2.CameraDevice;
+import android.hardware.camera2.CaptureRequest;
+import android.hardware.camera2.params.OutputConfiguration;
+import android.media.MediaPlayer;
+import android.util.ArraySet;
+import android.util.Log;
+import android.view.Surface;
+import java.io.File;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+public class VcamEngine {
+    private static final String TAG = "VCAM";
+    private static final String DISABLE_FLAG = "/sdcard/vcam_disable";
+    private static final String[] VIDEO_PATHS = new String[] {
+        "/sdcard/vcam.mp4",
+        "/sdcard/DCIM/Camera/vcam.mp4",
+        "/data/local/tmp/vcam.mp4"
+    };
+
+    private static final Map<CameraDevice, MediaPlayer> sPlayers = new ConcurrentHashMap<>();
+    private static final Map<CameraDevice, Surface> sRealSurfaces = new ConcurrentHashMap<>();
+    private static final Map<CameraDevice, SurfaceTexture> sDummyTextures = new ConcurrentHashMap<>();
+    private static final Map<Surface, Surface> sRealToDummy = new ConcurrentHashMap<>();
+
+    private static File getActiveVideoFile() {
+        if (new File(DISABLE_FLAG).exists()) {
+            return null;
+        }
+        for (String path : VIDEO_PATHS) {
+            File f = new File(path);
+            if (f.exists() && f.length() > 0 && f.canRead()) {
+                return f;
+            }
+        }
+        return null;
+    }
+
+    public static void prepareOutputs(final CameraDevice device, final List<OutputConfiguration> outputs) {
+        try {
+            final File videoFile = getActiveVideoFile();
+            if (videoFile == null || outputs == null || outputs.isEmpty()) {
+                return;
+            }
+
+            cleanupPlayer(device);
+
+            for (OutputConfiguration config : outputs) {
+                if (config != null && config.getSurface() != null && config.getSurface().isValid()) {
+                    Surface realSurface = config.getSurface();
+                    try {
+                        int width = 1280;
+                        int height = 720;
+                        try {
+                            Method mw = OutputConfiguration.class.getDeclaredMethod("getWidth");
+                            Method mh = OutputConfiguration.class.getDeclaredMethod("getHeight");
+                            width = ((Number) mw.invoke(config)).intValue();
+                            height = ((Number) mh.invoke(config)).intValue();
+                        } catch (Throwable ignored) {}
+
+                        SurfaceTexture dummyTex = new SurfaceTexture(10);
+                        dummyTex.setDefaultBufferSize(width, height);
+                        Surface dummySurf = new Surface(dummyTex);
+
+                        Field f = OutputConfiguration.class.getDeclaredField("mSurfaces");
+                        f.setAccessible(true);
+                        ArrayList<Surface> surfaces = (ArrayList<Surface>) f.get(config);
+                        if (surfaces != null && !surfaces.isEmpty()) {
+                            surfaces.set(0, dummySurf);
+                            sRealSurfaces.put(device, realSurface);
+                            sDummyTextures.put(device, dummyTex);
+                            sRealToDummy.put(realSurface, dummySurf);
+                            Log.i(TAG, "Replaced HAL surface with dummy to avoid BufferQueue conflict!");
+                            break;
+                        }
+                    } catch (Throwable t) {
+                        Log.e(TAG, "Failed to replace surface in config: " + t);
+                    }
+                }
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "prepareOutputs error: " + t);
+        }
+    }
+
+    public static void filterCaptureRequest(CaptureRequest request) {
+        if (request == null || sRealToDummy.isEmpty()) return;
+        try {
+            Field f = CaptureRequest.class.getDeclaredField("mSurfaceSet");
+            f.setAccessible(true);
+            ArraySet<Surface> set = (ArraySet<Surface>) f.get(request);
+            if (set != null) {
+                for (Map.Entry<Surface, Surface> entry : sRealToDummy.entrySet()) {
+                    if (set.contains(entry.getKey())) {
+                        set.remove(entry.getKey());
+                        set.add(entry.getValue());
+                    }
+                }
+            }
+        } catch (Throwable ignored) {}
+    }
+
+    public static void onSessionConfigured(final CameraDevice device, final List<OutputConfiguration> outputs) {
+        try {
+            final File videoFile = getActiveVideoFile();
+            if (videoFile == null) {
+                return;
+            }
+
+            Surface realSurface = sRealSurfaces.remove(device);
+            if (realSurface == null && outputs != null) {
+                for (OutputConfiguration config : outputs) {
+                    if (config != null && config.getSurface() != null && config.getSurface().isValid()) {
+                        realSurface = config.getSurface();
+                        break;
+                    }
+                }
+            }
+
+            if (realSurface == null) {
+                Log.w(TAG, "No valid target surface found for VCAM playback");
+                return;
+            }
+
+            final Surface surfaceToPlay = realSurface;
+            new Thread(new Runnable() {
+                @Override
+                public void run() {
+                    try {
+                        Thread.sleep(150);
+                        MediaPlayer mp = new MediaPlayer();
+                        mp.setDataSource(videoFile.getAbsolutePath());
+                        mp.setSurface(surfaceToPlay);
+                        mp.setLooping(true);
+                        mp.setVolume(0.0f, 0.0f);
+                        mp.prepare();
+                        mp.start();
+                        sPlayers.put(device, mp);
+                        Log.i(TAG, "VCAM playback successfully started for: " + videoFile.getAbsolutePath());
+                    } catch (Throwable t) {
+                        Log.e(TAG, "VCAM playback failed: ", t);
+                    }
+                }
+            }).start();
+
+        } catch (Throwable t) {
+            Log.e(TAG, "VCAM onSessionConfigured error: " + t);
+        }
+    }
+
+    public static void onCameraClose(CameraDevice device) {
+        cleanupPlayer(device);
+    }
+
+    private static void cleanupPlayer(CameraDevice device) {
+        if (device == null) return;
+        MediaPlayer mp = sPlayers.remove(device);
+        if (mp != null) {
+            try {
+                if (mp.isPlaying()) {
+                    mp.stop();
+                }
+                mp.release();
+            } catch (Throwable ignored) {}
+        }
+        Surface real = sRealSurfaces.remove(device);
+        if (real != null) {
+            sRealToDummy.remove(real);
+        }
+        SurfaceTexture dummyTex = sDummyTextures.remove(device);
+        if (dummyTex != null) {
+            try {
+                dummyTex.release();
+            } catch (Throwable ignored) {}
+        }
+    }
+}
diff --git a/media/java/android/media/VcamAudioEngine.java b/media/java/android/media/VcamAudioEngine.java
new file mode 100644
--- /dev/null
+++ b/media/java/android/media/VcamAudioEngine.java
@@ -0,0 +1,134 @@
+package android.media;
+
+import android.util.Log;
+import java.io.File;
+import java.io.RandomAccessFile;
+import java.nio.ByteBuffer;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+public class VcamAudioEngine {
+    private static final String TAG = "VCAM_AUDIO";
+    private static final String DISABLE_FLAG = "/sdcard/vcam_mic_disable";
+    private static final String[] AUDIO_PATHS = new String[] {
+        "/sdcard/vcam.wav",
+        "/sdcard/vcam.pcm",
+        "/data/local/tmp/vcam.wav",
+        "/data/local/tmp/vcam.pcm"
+    };
+
+    private static final Map<AudioRecord, RandomAccessFile> sFiles = new ConcurrentHashMap<>();
+
+    private static RandomAccessFile getFile(AudioRecord record) {
+        if (new File(DISABLE_FLAG).exists()) {
+            return null;
+        }
+        File audioFile = null;
+        for (String path : AUDIO_PATHS) {
+            File f = new File(path);
+            if (f.exists() && f.length() > 0 && f.canRead()) {
+                audioFile = f;
+                break;
+            }
+        }
+        if (audioFile == null) {
+            return null;
+        }
+
+        RandomAccessFile raf = sFiles.get(record);
+        if (raf == null) {
+            try {
+                raf = new RandomAccessFile(audioFile, "r");
+                if (audioFile.getName().endsWith(".wav")) {
+                    raf.seek(44);
+                }
+                sFiles.put(record, raf);
+                Log.i(TAG, "VCAM virtual audio opened: " + audioFile.getAbsolutePath());
+            } catch (Throwable t) {
+                Log.e(TAG, "Failed to open virtual audio: " + t.getMessage());
+                return null;
+            }
+        }
+        return raf;
+    }
+
+    public static void replaceBytes(AudioRecord record, byte[] audioData, int offsetInBytes, int sizeInBytes) {
+        try {
+            RandomAccessFile raf = getFile(record);
+            if (raf == null || audioData == null || sizeInBytes <= 0) return;
+
+            int totalRead = 0;
+            while (totalRead < sizeInBytes) {
+                int read = raf.read(audioData, offsetInBytes + totalRead, sizeInBytes - totalRead);
+                if (read < 0) {
+                    raf.seek(0);
+                    continue;
+                }
+                totalRead += read;
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "replaceBytes error: " + t.getMessage());
+        }
+    }
+
+    public static void replaceShorts(AudioRecord record, short[] audioData, int offsetInShorts, int sizeInShorts) {
+        try {
+            RandomAccessFile raf = getFile(record);
+            if (raf == null || audioData == null || sizeInShorts <= 0) return;
+
+            int bytesNeeded = sizeInShorts * 2;
+            byte[] byteBuf = new byte[bytesNeeded];
+            int totalRead = 0;
+            while (totalRead < bytesNeeded) {
+                int read = raf.read(byteBuf, totalRead, bytesNeeded - totalRead);
+                if (read < 0) {
+                    raf.seek(0);
+                    continue;
+                }
+                totalRead += read;
+            }
+
+            for (int i = 0; i < sizeInShorts; i++) {
+                int b1 = byteBuf[i * 2] & 0xFF;
+                int b2 = byteBuf[i * 2 + 1];
+                audioData[offsetInShorts + i] = (short) ((b2 << 8) | b1);
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "replaceShorts error: " + t.getMessage());
+        }
+    }
+
+    public static void replaceBuffer(AudioRecord record, ByteBuffer audioBuffer, int sizeInBytes) {
+        try {
+            RandomAccessFile raf = getFile(record);
+            if (raf == null || audioBuffer == null || sizeInBytes <= 0) return;
+
+            byte[] byteBuf = new byte[sizeInBytes];
+            int totalRead = 0;
+            while (totalRead < sizeInBytes) {
+                int read = raf.read(byteBuf, totalRead, sizeInBytes - totalRead);
+                if (read < 0) {
+                    raf.seek(0);
+                    continue;
+                }
+                totalRead += read;
+            }
+            int pos = audioBuffer.position();
+            if (pos >= sizeInBytes) {
+                audioBuffer.position(pos - sizeInBytes);
+                audioBuffer.put(byteBuf, 0, sizeInBytes);
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "replaceBuffer error: " + t.getMessage());
+        }
+    }
+
+    public static void onAudioRecordRelease(AudioRecord record) {
+        RandomAccessFile raf = sFiles.remove(record);
+        if (raf != null) {
+            try {
+                raf.close();
+            } catch (Throwable ignored) {}
+        }
+    }
+}
+