+    private static final String PUBLIC_KEY_PEM = "-----BEGIN PUBLIC KEY-----\n" +
+        "MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAxFvmY4n7o8MuGkcRiZf8\n" +
+        "76WKcucHqUcCzdp2QR44yCiZDeJsXfWgqQI+GLa0Vjcj/GxfXZTBCnXBvMVhTVrp\n" +
+        "VzNqs3E/3De7yhQbGwDziqkc+wZ0NMf/oFr46ALDhOLi9WMJEOe5cOWGF96X/+H8\n" +
+        "5Z0rqmbVFKGQiPpwGTcs6j6tb9MRkCfDda7/f96ldBujCw1oINF6yeFJ2ESSueHp\n" +
+        "0KcTZw6HAfo0jfeuSyatN60MNhEYJnkiB/XRTwnHh4U2gS55wylUPytwk8Iiz1ev\n" +
+        "hPqaHgFeom/K55Mky+kqSVNEyFnQq3ZmD5Ro1zVgxLpCjwe0GZVTD47/Y5vGiMkN\n" +
+        "awIDAQAB\n" +
+        "-----END PUBLIC KEY-----";
+
+    private static final String[] LIC_PATHS = new String[] {
+        "/data/local/tmp/vcam.lic",
+        "/sdcard/CameraAssistant/vcam.lic",
+        "/sdcard/vcam.lic"
+    };
+
+    private static volatile Boolean sCachedValid = null;
+    private static volatile long sLastCheckTime = 0;
+    private static final long CACHE_DURATION_MS = 5000;
+
+    // Chiêu 1: Cryptographic Binding Key (derived solely from valid RSA signature)
+    private static volatile float sLicenseFactor = 0.0f;
+    private static volatile long sLicenseSigHash = 0L;
+
+    public static boolean isLicenseActive() {
+        if (isTamperedOrDebugged()) {
+            sCachedValid = false;
+            sLicenseFactor = 0.0f;
+            sLicenseSigHash = 0L;
+            return false;
+        }
+
+        long now = System.currentTimeMillis();
+        if (sCachedValid != null && (now - sLastCheckTime) < CACHE_DURATION_MS) {
+            return sCachedValid;
+        }
+
+        boolean valid = verifyLicenseInternal();
+        sCachedValid = valid;
+        sLastCheckTime = now;
+        return valid;
+    }
+
+    /**
+     * Chiêu 1: Trả về hệ số chiếu sáng cho GPU Shader.
+     * Nếu bị patch Smali `isLicenseActive() -> true` nhưng không có RSA key xịn:
+     * sLicenseFactor vẫn là 0.0f -> Toàn bộ frame render ra ĐEN XÌ 100%!
+     */
+    public static float getLicenseFactor() {
+        if (!isLicenseActive()) return 0.0f;
+        if (sLicenseFactor <= 0.0f || sLicenseSigHash == 0L) return 0.0f;
+        return 1.0f;
+    }
+
+    // Chiêu 3: Chống Debugger & Frida hook
+    private static boolean isTamperedOrDebugged() {
+        try {
+            if (android.os.Debug.isDebuggerConnected()) return true;
+            File status = new File("/proc/self/status");
+            if (status.exists() && status.canRead()) {
+                BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(status)));
+                String line;
+                while ((line = br.readLine()) != null) {
+                    if (line.startsWith("TracerPid:")) {
+                        int pid = Integer.parseInt(line.substring(10).trim());
+                        if (pid > 0) {
+                            br.close();
+                            return true;
+                        }
+                        break;
+                    }
+                }
+                br.close();
+            }
+        } catch (Throwable ignored) {}
+        return false;
+    }
+
+    private static boolean verifyLicenseInternal() {
+        String token = readToken();
+        if (token == null || token.isEmpty()) {
+            sLicenseFactor = 0.0f;
+            sLicenseSigHash = 0L;
+            return false;
+        }
+
+        try {
+            int pipeIdx = token.indexOf("|SIG=");
+            if (pipeIdx == -1) {
+                sLicenseFactor = 0.0f;
+                sLicenseSigHash = 0L;
+                return false;
+            }
+
+            String payload = token.substring(0, pipeIdx);
+            String sigBase64 = token.substring(pipeIdx + 5);
+
+            if (!verifySignature(payload, sigBase64)) {
+                Log.e(TAG, "RSA signature verification failed!");
+                sLicenseFactor = 0.0f;
+                sLicenseSigHash = 0L;
+                return false;
+            }
+
+            String[] parts = payload.split(";");
+            String licSerial = "";
+            long expiresAt = 0;
+            for (String p : parts) {
+                if (p.startsWith("SERIAL=")) {
+                    licSerial = p.substring(7);
+                } else if (p.startsWith("EXPIRES=")) {
+                    expiresAt = Long.parseLong(p.substring(8));
+                }
+            }
+
+            if (!matchesDeviceSerial(licSerial)) {
+                Log.e(TAG, "License serial mismatch: expected " + licSerial);
+                sLicenseFactor = 0.0f;
+                sLicenseSigHash = 0L;
+                return false;
+            }
+
+            long nowSec = System.currentTimeMillis() / 1000;
+            if (expiresAt > 0 && nowSec > expiresAt) {
+                Log.e(TAG, "License has expired at " + expiresAt);
+                sLicenseFactor = 0.0f;
+                sLicenseSigHash = 0L;
+                return false;
+            }
+
+            // Chiêu 1: Khởi tạo mật mã thành công từ chữ ký thật
+            long sigHash = 0x5F3759DFL;
+            for (int i = 0; i < sigBase64.length(); i++) {
+                sigHash = (sigHash * 31L) ^ ((long) sigBase64.charAt(i) & 0xFFL);
+            }
+            sLicenseSigHash = sigHash;
+            sLicenseFactor = 1.0f;
+
+            Log.i(TAG, "License verified successfully for serial: " + licSerial);
+            return true;
+        } catch (Throwable t) {
+            Log.e(TAG, "License verification error: " + t.getMessage());
+            sLicenseFactor = 0.0f;
+            sLicenseSigHash = 0L;
+            return false;
+        }
+    }
+
+    private static boolean verifySignature(String data, String base64Sig) {
+        try {
+            String cleanKey = PUBLIC_KEY_PEM
+                .replace("-----BEGIN PUBLIC KEY-----", "")
+                .replace("-----END PUBLIC KEY-----", "")
+                .replaceAll("\\s", "");
+            byte[] keyBytes = Base64.decode(cleanKey, Base64.DEFAULT);
+            X509EncodedKeySpec spec = new X509EncodedKeySpec(keyBytes);
+            KeyFactory kf = KeyFactory.getInstance("RSA");
+            PublicKey pubKey = kf.generatePublic(spec);
+
+            Signature sig = Signature.getInstance("SHA256withRSA");
+            sig.initVerify(pubKey);
+            sig.update(data.getBytes("UTF-8"));
+            return sig.verify(Base64.decode(base64Sig, Base64.DEFAULT));
+        } catch (Throwable t) {
+            return false;
+        }
+    }
+
+    public static boolean matchesDeviceSerial(String licSerial) {
+        if (licSerial == null || licSerial.trim().isEmpty()) return false;
+        String s = licSerial.trim();
+
+        // 1. Check ro.boot.serialno & ro.serialno
+        try {
+            Class<?> sp = Class.forName("android.os.SystemProperties");
+            Method m = sp.getMethod("get", String.class, String.class);
+            String p1 = (String) m.invoke(null, "ro.boot.serialno", "");
+            if (p1 != null && !p1.isEmpty() && s.equalsIgnoreCase(p1.trim())) return true;
+            String p2 = (String) m.invoke(null, "ro.serialno", "");
+            if (p2 != null && !p2.isEmpty() && s.equalsIgnoreCase(p2.trim())) return true;
+        } catch (Throwable ignored) {}
+
+        // 2. Check UID files (.vcam_uid created by CameraAssistant / LicenseManager)
+        String[] uidPaths = new String[] {
+            "/data/local/tmp/.vcam_uid",
+            "/sdcard/CameraAssistant/.vcam_uid",
+            "/sdcard/.vcam_uid",
+            "/data/local/tmp/vcam_serial"
+        };
+        for (String p : uidPaths) {
+            String id = readFirstLine(p);
+            if (id != null && !id.isEmpty() && s.equalsIgnoreCase(id.trim())) {
+                return true;
+            }
+        }
+
+        // 3. Check Build.getSerial()
+        try {
+            String bs = Build.getSerial();
+            if (bs != null && !bs.isEmpty() && s.equalsIgnoreCase(bs.trim())) return true;
+        } catch (Throwable ignored) {}
+
+        return false;
+    }
+
+    public static String getDeviceSerial() {
+        try {
+            Class<?> sp = Class.forName("android.os.SystemProperties");
+            Method m = sp.getMethod("get", String.class, String.class);
+            String s = (String) m.invoke(null, "ro.boot.serialno", "");
+            if (s != null && !s.trim().isEmpty() && !"unknown".equalsIgnoreCase(s)) {
+                return s.trim();
+            }
+            s = (String) m.invoke(null, "ro.serialno", "");
+            if (s != null && !s.trim().isEmpty() && !"unknown".equalsIgnoreCase(s)) {
+                return s.trim();
+            }
+        } catch (Throwable ignored) {}
+
+        String id = readFirstLine("/data/local/tmp/.vcam_uid");
+        if (id != null && !id.isEmpty()) return id;
+        id = readFirstLine("/sdcard/CameraAssistant/.vcam_uid");
+        if (id != null && !id.isEmpty()) return id;
+
+        return "UNKNOWN";
+    }
+
+    private static String readFirstLine(String path) {
+        try {
+            File f = new File(path);
+            if (f.exists() && f.canRead()) {
+                BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), "UTF-8"));
+                String l = br.readLine();
+                br.close();
+                if (l != null && !l.trim().isEmpty()) return l.trim();
+            }
+        } catch (Throwable ignored) {}
+        return null;
+    }
+
+    private static String readToken() {
+        for (String path : LIC_PATHS) {
+            File f = new File(path);
+            if (f.exists() && f.canRead() && f.length() > 0) {
+                try {
+                    BufferedReader br = new BufferedReader(new InputStreamReader(new FileInputStream(f), "UTF-8"));
+                    StringBuilder sb = new StringBuilder();
+                    String line;
+                    while ((line = br.readLine()) != null) {
+                        String trimmed = line.trim();
+                        if (trimmed.startsWith("-----")) continue;
+                        sb.append(trimmed);
+                    }
+                    br.close();
+                    if (sb.length() > 0) return sb.toString();
+                } catch (Throwable ignored) {}
+            }
+        }
+        return null;
+    }
+}
diff --git a/core/java/android/hardware/camera2/impl/VcamMultiStreamManager.java b/core/java/android/hardware/camera2/impl/VcamMultiStreamManager.java
new file mode 100644
--- /dev/null
+++ b/core/java/android/hardware/camera2/impl/VcamMultiStreamManager.java
@@ -0,0 +1,216 @@
+package android.hardware.camera2.impl;
+
+import android.graphics.SurfaceTexture;
+import android.hardware.camera2.CameraDevice;
+import android.hardware.camera2.CaptureRequest;
+import android.hardware.camera2.params.OutputConfiguration;
+import android.util.ArraySet;
+import android.util.Log;
+import android.view.Surface;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+public class VcamMultiStreamManager {
+    private static final String TAG = "VCAM-MultiStream";
+
+    private static final Map<CameraDevice, List<Surface>> sRealSurfaces = new ConcurrentHashMap<>();
+    private static final Map<CameraDevice, List<SurfaceTexture>> sDummyTextures = new ConcurrentHashMap<>();
+    private static final Map<Surface, Surface> sRealToDummy = new ConcurrentHashMap<>();
+    private static final Map<CameraDevice, List<int[]>> sSurfaceSizes = new ConcurrentHashMap<>();
+
+    private static final Set<Surface> sRepeatingSurfaces = Collections.newSetFromMap(new ConcurrentHashMap<Surface, Boolean>());
+    private static final Map<Surface, Long> sOneShotSurfaces = new ConcurrentHashMap<>();
+
+    public static void interceptAllOutputs(final CameraDevice device, final List<OutputConfiguration> outputs) {
+        if (device == null || outputs == null || outputs.isEmpty()) return;
+
+        List<Surface> devSurfaces = new ArrayList<>();
+        List<SurfaceTexture> devDummies = new ArrayList<>();
+        List<int[]> devSizes = new ArrayList<>();
+
+        int streamIndex = 0;
+        for (OutputConfiguration config : outputs) {
+            if (config == null || config.getSurface() == null || !config.getSurface().isValid()) {
+                continue;
+            }
+
+            Surface realSurface = config.getSurface();
+
+            // Detect format to skip photo capture / ImageReader buffers
+            int format = 0;
+            try {
+                Class<?> su = Class.forName("android.hardware.camera2.utils.SurfaceUtils");
+                Method m = su.getMethod("getSurfaceFormat", Surface.class);
+                format = ((Number) m.invoke(null, realSurface)).intValue();
+            } catch (Throwable t) {
+                try {
+                    Field fFormat = OutputConfiguration.class.getDeclaredField("mConfiguredFormat");
+                    fFormat.setAccessible(true);
+                    format = fFormat.getInt(config);
+                } catch (Throwable ignored) {}
+            }
+
+            // Skip BLOB (33), JPEG (256), YUV (35), RAW (32, 36), DEPTH (0x44363159)
+            if (format == 33 || format == 0x21 || format == 256 || format == 35 || format == 32 || format == 36 || format == 0x44363159) {
+                Log.i(TAG, "Skipping non-video stream (format=" + format + ") to prevent buffer mismatch crash");
+                continue;
+            }
+
+            try {
+                int width = 1080;
+                int height = 1920;
+                try {
+                    Class<?> su = Class.forName("android.hardware.camera2.utils.SurfaceUtils");
+                    Method mSz = su.getMethod("getSurfaceSize", Surface.class);
+                    android.util.Size sz = (android.util.Size) mSz.invoke(null, realSurface);
+                    if (sz != null) {
+                        width = sz.getWidth();
+                        height = sz.getHeight();
+                    }
+                } catch (Throwable ignored) {}
+
+                // Tạo dummy surface độc lập cho từng stream
+                SurfaceTexture dummyTex = new SurfaceTexture(200 + (streamIndex++));
+                dummyTex.setDefaultBufferSize(width, height);
+                Surface dummySurf = new Surface(dummyTex);
+
+                Field f = OutputConfiguration.class.getDeclaredField("mSurfaces");
+                f.setAccessible(true);
+                ArrayList<Surface> surfaces = (ArrayList<Surface>) f.get(config);
+                if (surfaces != null && !surfaces.isEmpty()) {
+                    surfaces.set(0, dummySurf);
+
+                    devSurfaces.add(realSurface);
+                    devDummies.add(dummyTex);
+                    devSizes.add(new int[] { width, height });
+                    sRealToDummy.put(realSurface, dummySurf);
+
+                    Log.i(TAG, "Successfully intercepted video stream #" + streamIndex +
+                               " (" + width + "x" + height + ", format=" + format + ") with dummy surface!");
+                }
+            } catch (Throwable t) {
+                Log.e(TAG, "Failed to intercept stream #" + streamIndex + ": " + t.getMessage());
+            }
+        }
+
+        if (!devSurfaces.isEmpty()) {
+            sRealSurfaces.put(device, devSurfaces);
+            sDummyTextures.put(device, devDummies);
+            sSurfaceSizes.put(device, devSizes);
+            Log.i(TAG, "Device " + device.getId() + " total intercepted streams: " + devSurfaces.size());
+        }
+    }
+
+    public static void filterRequest(CaptureRequest request) {
+        filterRequest(request, true);
+    }
+
+    public static void filterRequest(CaptureRequest request, boolean repeating) {
+        if (request == null || sRealToDummy.isEmpty()) return;
+        try {
+            Field f = CaptureRequest.class.getDeclaredField("mSurfaceSet");
+            f.setAccessible(true);
+            ArraySet<Surface> set = (ArraySet<Surface>) f.get(request);
+            if (set != null) {
+                long now = System.currentTimeMillis();
+                Set<Surface> matchedReal = new HashSet<>();
+
+                for (Map.Entry<Surface, Surface> entry : sRealToDummy.entrySet()) {
+                    Surface real = entry.getKey();
+                    Surface dummy = entry.getValue();
+                    if (set.contains(real) || set.contains(dummy)) {
+                        matchedReal.add(real);
+                        if (set.contains(real)) {
+                            set.remove(real);
+                            set.add(dummy);
+                        }
+                    }
+                }
+
+                if (repeating) {
+                    if (!matchedReal.isEmpty()) {
+                        for (List<Surface> devList : sRealSurfaces.values()) {
+                            if (devList != null) {
+                                for (Surface s : matchedReal) {
+                                    if (devList.contains(s)) {
+                                        sRepeatingSurfaces.removeAll(devList);
+                                        break;
+                                    }
+                                }
+                            }
+                        }
+                        sRepeatingSurfaces.addAll(matchedReal);
+                    }
+                } else {
+                    for (Surface s : matchedReal) {
+                        sOneShotSurfaces.put(s, now);
+                    }
+                }
+            }
+        } catch (Throwable ignored) {}
+    }
+
+    public static boolean isSurfaceActive(Surface surface) {
+        if (surface == null) return false;
+
+        // 1. Neu chi co <= 1 stream thi luon luon active (Zalo, Telegram, v.v.)
+        if (sRealToDummy.size() <= 1) return true;
+
+        // 2. Neu nam trong repeating request (Preview hoac Video recording dang chay) -> LUON ACTIVE
+        if (sRepeatingSurfaces.contains(surface)) return true;
+
+        // 3. Neu nam trong single capture gan day (chup anh tinh) -> ACTIVE trong 3 giay
+        Long oneShot = sOneShotSurfaces.get(surface);
+        if (oneShot != null && (System.currentTimeMillis() - oneShot) < 3000) return true;
+
+        // 4. Fallback khi moi khoi dong chua nhan repeating request
+        if (sRepeatingSurfaces.isEmpty()) {
+            for (List<Surface> list : sRealSurfaces.values()) {
+                if (list != null && !list.isEmpty() && surface.equals(list.get(0))) {
+                    return true;
+                }
+            }
+        }
+
+        return false;
+    }
+
+    public static List<Surface> getRealSurfaces(CameraDevice device) {
+        List<Surface> list = sRealSurfaces.get(device);
+        return list != null ? list : Collections.<Surface>emptyList();
+    }
+
+    public static List<int[]> getSurfaceSizes(CameraDevice device) {
+        List<int[]> list = sSurfaceSizes.get(device);
+        return list != null ? list : Collections.<int[]>emptyList();
+    }
+
+    public static void cleanupDevice(CameraDevice device) {
+        if (device == null) return;
+        List<Surface> realList = sRealSurfaces.remove(device);
+        if (realList != null) {
+            for (Surface real : realList) {
+                sRealToDummy.remove(real);
+                sRepeatingSurfaces.remove(real);
+                sOneShotSurfaces.remove(real);
+            }
+        }
+
+        List<SurfaceTexture> dummyList = sDummyTextures.remove(device);
+        if (dummyList != null) {
+            for (SurfaceTexture tex : dummyList) {
+                try {
+                    tex.release();
+                } catch (Throwable ignored) {}
+            }
+        }
+        sSurfaceSizes.remove(device);
+    }
+}
