+package android.hardware.camera2.impl;
+
+import android.hardware.Camera;
+import android.media.MediaCodec;
+import android.media.MediaExtractor;
+import android.media.MediaFormat;
+import android.util.Log;
+import android.view.Surface;
+import java.io.File;
+import java.nio.ByteBuffer;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+public class VcamCamera1Engine {
+    private static final String TAG = "VcamCamera1Engine";
+
+    public static class Camera1Player implements Runnable {
+        final File file;
+        final Surface surface;
+        final int targetWidth;
+        final int targetHeight;
+        volatile boolean running = true;
+        Thread thread;
+
+        public Camera1Player(File file, Surface surface, int width, int height) {
+            this.file = file;
+            this.surface = surface;
+            this.targetWidth = width > 0 ? width : 1280;
+            this.targetHeight = height > 0 ? height : 720;
+        }
+
+        public void start() {
+            thread = new Thread(this, "VCAM-Camera1Decoder");
+            thread.start();
+        }
+
+        public void stop() {
+            running = false;
+            if (thread != null) {
+                thread.interrupt();
+            }
+        }
+
+        @Override
+        public void run() {
+            Log.i(TAG, "Camera1 MediaCodec decoder thread started for: " + file.getAbsolutePath() +
+                       " (" + targetWidth + "x" + targetHeight + ")");
+            while (running && surface != null && surface.isValid()) {
+                MediaExtractor extractor = null;
+                MediaCodec decoder = null;
+                try {
+                    extractor = new MediaExtractor();
+                    extractor.setDataSource(file.getAbsolutePath());
+
+                    int videoTrackIndex = -1;
+                    MediaFormat format = null;
+                    int numTracks = extractor.getTrackCount();
+                    for (int i = 0; i < numTracks; i++) {
+                        MediaFormat mf = extractor.getTrackFormat(i);
+                        String mime = mf.getString(MediaFormat.KEY_MIME);
+                        if (mime != null && mime.startsWith("video/")) {
+                            videoTrackIndex = i;
+                            format = mf;
+                            break;
+                        }
+                    }
+
+                    if (videoTrackIndex < 0 || format == null) {
+                        Log.e(TAG, "No video track found in " + file.getAbsolutePath());
+                        return;
+                    }
+
+                    extractor.selectTrack(videoTrackIndex);
+                    String mime = format.getString(MediaFormat.KEY_MIME);
+                    decoder = MediaCodec.createDecoderByType(mime);
+                    decoder.configure(format, surface, null, 0);
+                    decoder.start();
+
+                    int fps = 30;
+                    if (format.containsKey(MediaFormat.KEY_FRAME_RATE)) {
+                        try {
+                            fps = format.getInteger(MediaFormat.KEY_FRAME_RATE);
+                            if (fps <= 0 || fps > 60) fps = 30;
+                        } catch (Throwable ignored) {}
+                    }
+                    long frameDelayMs = 1000 / fps;
+
+                    MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+                    long nextFrameTimeMs = System.currentTimeMillis();
+                    long lastRewindTs = VcamConfig.getRewindTimestamp();
+
+                    while (running && surface.isValid()) {
+                        long curRewindTs = VcamConfig.getRewindTimestamp();
+                        if (curRewindTs > lastRewindTs) {
+                            lastRewindTs = curRewindTs;
+                            try {
+                                extractor.seekTo(0, MediaExtractor.SEEK_TO_CLOSEST_SYNC);
+                                decoder.flush();
+                                nextFrameTimeMs = System.currentTimeMillis();
+                                Log.i(TAG, "Camera1 Video rewound to 00:00 (ts=" + curRewindTs + ")");
+                            } catch (Throwable t) {
+                                Log.w(TAG, "Camera1 Video rewind error: " + t);
+                            }
+                        }
+
+                        if (VcamConfig.isPaused()) {
+                            try {
+                                Thread.sleep(40);
+                            } catch (InterruptedException ignored) {
+                                break;
+                            }
+                            continue;
+                        }
+
+                        int inIdx = decoder.dequeueInputBuffer(10000);
+                        if (inIdx >= 0) {
+                            ByteBuffer inputBuffer = decoder.getInputBuffer(inIdx);
+                            if (inputBuffer != null) {
+                                int sampleSize = extractor.readSampleData(inputBuffer, 0);
+                                if (sampleSize < 0) {
+                                    extractor.seekTo(0, MediaExtractor.SEEK_TO_CLOSEST_SYNC);
+                                    sampleSize = extractor.readSampleData(inputBuffer, 0);
+                                }
+                                if (sampleSize > 0) {
+                                    decoder.queueInputBuffer(inIdx, 0, sampleSize, extractor.getSampleTime(), 0);
+                                    extractor.advance();
+                                } else {
+                                    decoder.queueInputBuffer(inIdx, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM);
+                                }
+                            }
+                        }
+
+                        int outIdx = decoder.dequeueOutputBuffer(info, 10000);
+                        if (outIdx >= 0) {
+                            long now = System.currentTimeMillis();
+                            if (now < nextFrameTimeMs) {
+                                try {
+                                    Thread.sleep(nextFrameTimeMs - now);
+                                } catch (InterruptedException ignored) {
+                                    break;
+                                }
+                            }
+                            nextFrameTimeMs = System.currentTimeMillis() + frameDelayMs;
+
+                            try {
+                                decoder.releaseOutputBuffer(outIdx, true);
+                            } catch (Throwable e) {
+                                Log.w(TAG, "releaseOutputBuffer dropped frame: " + e.getMessage());
+                            }
+                        }
+                    }
+                } catch (Throwable t) {
+                    if (running) {
+                        Log.e(TAG, "Camera1 MediaCodec playback loop error: " + t.getMessage(), t);
+                    }
+                } finally {
+                    if (decoder != null) {
+                        try {
+                            decoder.stop();
+                            decoder.release();
+                        } catch (Throwable ignored) {}
+                    }
+                    if (extractor != null) {
+                        try {
+                            extractor.release();
+                        } catch (Throwable ignored) {}
+                    }
+                    if (running) {
+                        try {
+                            Thread.sleep(50);
+                        } catch (InterruptedException ignored) {
+                            break;
+                        }
+                    }
+                }
+            }
+            Log.i(TAG, "Camera1 MediaCodec decoder thread stopped.");
+        }
+    }
+
+    private static final Map<Camera, Camera1Player> sPlayers = new ConcurrentHashMap<>();
+
+    public static void startPreview(Camera camera, Surface surface, int width, int height) {
+        try {
+            if (!VcamLicenseVerifier.isLicenseActive()) return;
+            if (VcamConfig.isVcamDisabled()) return;
+
+            final File videoFile = VcamConfig.getActiveVideoFile();
+            if (videoFile == null || surface == null || !surface.isValid()) return;
+
+            stopPreview(camera);
+
+            Camera1Player player = new Camera1Player(videoFile, surface, width, height);
+            sPlayers.put(camera, player);
+            player.start();
+            Log.i(TAG, "Started Vcam Camera1Player for camera: " + camera);
+        } catch (Throwable t) {
+            Log.e(TAG, "startPreview error: " + t);
+        }
+    }
+
+    public static void stopPreview(Camera camera) {
+        if (camera == null) return;
+        Camera1Player player = sPlayers.remove(camera);
+        if (player != null) {
+            player.stop();
+            Log.i(TAG, "Stopped Vcam Camera1Player for camera: " + camera);
+        }
+    }
+
+    public static void release(Camera camera) {
+        stopPreview(camera);
+    }
+}
diff --git a/core/java/android/hardware/camera2/impl/VcamFaceMetadata.java b/core/java/android/hardware/camera2/impl/VcamFaceMetadata.java
new file mode 100644
index 0000000..1234567
--- /dev/null
+++ b/core/java/android/hardware/camera2/impl/VcamFaceMetadata.java
@@ -0,0 +1,357 @@
+package android.hardware.camera2.impl;
+
+import android.graphics.Point;
+import android.graphics.Rect;
+import android.hardware.camera2.CameraCharacteristics;
+import android.hardware.camera2.CameraMetadata;
+import android.hardware.camera2.CaptureRequest;
+import android.hardware.camera2.CaptureResult;
+import android.hardware.camera2.params.Face;
+import android.util.Log;
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileReader;
+import java.lang.reflect.Constructor;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * VcamFaceMetadata - Tu dong tong hop va inject face metadata (Face detection + ISP Sensor stats)
+ * vao CameraMetadataNative trong AOSP Camera framework.
+ *
+ * Dong bo hoa 100% tu logic face_metadata_hook.cpp cua du an native_hook:
+ * Injects Face Rectangles, Scores, IDs, Landmarks va 3A Converged states cho moi CaptureResult.
+ */
+public class VcamFaceMetadata {
+    private static final String TAG = "VcamFaceMetadata";
+
+    private static final String[] SEARCH_DIRS = new String[] {
+        "/data/local/tmp/",
+        "/sdcard/"
+    };
+
+    private static final String FACE_CFG_NAME = "vcam_face";
+    private static final String FACE_DISABLE_NAME = "vcam_face_disable";
+    private static final String RAW_EXP_NAME = "vcam_raw_exp";
+
+    private static class FaceBox {
+        final int x, y, w, h;
+        final int score;
+
+        FaceBox(int x, int y, int w, int h, int score) {
+            this.x = x;
+            this.y = y;
+            this.w = w;
+            this.h = h;
+            this.score = Math.max(1, Math.min(100, score));
+        }
+    }
+
+    private static volatile long sLastDisableCheck = 0;
+    private static volatile boolean sCachedDisabled = false;
+
+    private static volatile long sLastCfgReadMs = 0;
+    private static volatile List<FaceBox> sCachedCustomFaces = null;
+
+    private static volatile long sCachedExpTime = 66500000L; // ~1/15s
+    private static volatile int sCachedIso = 80;
+    private static volatile long sLastExpCheckMs = 0;
+    private static volatile long sLastLogTime = 0;
+
+    // Reflection cache for Face constructors
+    private static volatile Constructor<Face> sFaceFullCtor = null;
+    private static volatile Constructor<Face> sFaceSimpleCtor = null;
+    private static volatile boolean sCtorResolved = false;
+
+    private static synchronized void resolveFaceConstructors() {
+        if (sCtorResolved) return;
+        sCtorResolved = true;
+        try {
+            sFaceFullCtor = Face.class.getDeclaredConstructor(
+                    Rect.class, int.class, int.class,
+                    Point.class, Point.class, Point.class
+            );
+            sFaceFullCtor.setAccessible(true);
+        } catch (Throwable t) {
+            Log.w(TAG, "Full Face constructor not found: " + t);
+        }
+        try {
+            sFaceSimpleCtor = Face.class.getDeclaredConstructor(Rect.class, int.class);
+            sFaceSimpleCtor.setAccessible(true);
+        } catch (Throwable t) {
+            Log.w(TAG, "Simple Face constructor not found: " + t);
+        }
+    }
+
+    private static Face createFace(Rect bounds, int score, int id, Point leftEye, Point rightEye, Point mouth) {
+        resolveFaceConstructors();
+        if (sFaceFullCtor != null) {
+            try {
+                return sFaceFullCtor.newInstance(bounds, score, id, leftEye, rightEye, mouth);
+            } catch (Throwable ignored) {}
+        }
+        if (sFaceSimpleCtor != null) {
+            try {
+                return sFaceSimpleCtor.newInstance(bounds, score);
+            } catch (Throwable ignored) {}
+        }
+        return null;
+    }
+
+    public static boolean isFaceDetectionDisabled() {
+        long now = System.currentTimeMillis();
+        if (now - sLastDisableCheck < 200) {
+            return sCachedDisabled;
+        }
+        sLastDisableCheck = now;
+
+        for (String dir : SEARCH_DIRS) {
+            File f = new File(dir + FACE_DISABLE_NAME);
+            if (f.exists()) {
+                sCachedDisabled = true;
+                return true;
+            }
+        }
+        sCachedDisabled = false;
+        return false;
+    }
+
+    private static List<FaceBox> readCustomFaces() {
+        long now = System.currentTimeMillis();
+        if (now - sLastCfgReadMs < 200) {
+            return sCachedCustomFaces;
+        }
+        sLastCfgReadMs = now;
+
+        File targetFile = null;
+        for (String dir : SEARCH_DIRS) {
+            File f = new File(dir + FACE_CFG_NAME);
+            if (f.exists() && f.canRead()) {
+                targetFile = f;
+                break;
+            }
+        }
+
+        if (targetFile == null) {
+            sCachedCustomFaces = null;
+            return null;
+        }
+
+        // Bo qua neu file qua 5 giay (stale tu phien cu)
+        if (now - targetFile.lastModified() > 5000) {
+            sCachedCustomFaces = null;
+            return null;
+        }
+
+        List<FaceBox> list = new ArrayList<>();
+        BufferedReader reader = null;
+        try {
+            reader = new BufferedReader(new FileReader(targetFile));
+            String line;
+            while ((line = reader.readLine()) != null && list.size() < 4) {
+                line = line.trim();
+                if (line.isEmpty() || line.startsWith("#")) continue;
+                String[] parts = line.split("\\s+");
+                if (parts.length >= 4) {
+                    int x = Integer.parseInt(parts[0]);
+                    int y = Integer.parseInt(parts[1]);
+                    int w = Integer.parseInt(parts[2]);
+                    int h = Integer.parseInt(parts[3]);
+                    int sc = (parts.length >= 5) ? Integer.parseInt(parts[4]) : 99;
+                    if (w > 0 && h > 0) {
+                        list.add(new FaceBox(x, y, w, h, sc));
+                    }
+                }
+            }
+        } catch (Throwable ignored) {
+        } finally {
+            if (reader != null) {
+                try { reader.close(); } catch (Throwable ignored) {}
+            }
+        }
+
+        sCachedCustomFaces = list.isEmpty() ? null : list;
+        return sCachedCustomFaces;
+    }
+
+    private static void updateSensorExposure() {
+        long now = System.currentTimeMillis();
+        if (now - sLastExpCheckMs < 500) return;
+        sLastExpCheckMs = now;
+
+        File targetFile = null;
+        for (String dir : SEARCH_DIRS) {
+            File f = new File(dir + RAW_EXP_NAME);
+            if (f.exists() && f.canRead()) {
+                targetFile = f;
+                break;
+            }
+        }
+        if (targetFile != null) {
+            BufferedReader reader = null;
+            try {
+                reader = new BufferedReader(new FileReader(targetFile));
+                String line = reader.readLine();
+                if (line != null) {
+                    String[] parts = line.trim().split("\\s+");
+                    if (parts.length >= 1) {
+                        long exp = Long.parseLong(parts[0]);
+                        if (exp > 1000000L) sCachedExpTime = exp;
+                    }
+                    if (parts.length >= 2) {
+                        int iso = Integer.parseInt(parts[1]);
+                        if (iso > 0) sCachedIso = iso;
+                    }
+                }
+            } catch (Throwable ignored) {
+            } finally {
+                if (reader != null) {
+                    try { reader.close(); } catch (Throwable ignored) {}
+                }
+            }
+        }
+    }
+
+    /**
+     * Inject face metadata va ISP sensor parameters vao CameraMetadataNative.
+     */
+    public static void inject(CameraDeviceImpl device, CameraMetadataNative result, CaptureRequest request) {
+        if (result == null) return;
+        if (isFaceDetectionDisabled()) return;
+
+        try {
+            // 1. Xac dinh crop region va sensor active array
+            int cx = 0, cy = 0, cw = 3280, ch = 2464;
+            Rect crop = null;
+            if (request != null) {
+                crop = request.get(CaptureRequest.SCALER_CROP_REGION);
+            }
+            if (crop == null && device != null) {
+                try {
+                    java.lang.reflect.Method mChar = device.getClass().getDeclaredMethod("getCharacteristics");
+                    mChar.setAccessible(true);
+                    CameraCharacteristics chars = (CameraCharacteristics) mChar.invoke(device);
+                    if (chars != null) {
+                        crop = chars.get(CameraCharacteristics.SENSOR_INFO_ACTIVE_ARRAY_SIZE);
+                    }
+                } catch (Throwable ignored) {}
+            }
+            if (crop != null && crop.width() > 0 && crop.height() > 0) {
+                cx = crop.left;
+                cy = crop.top;
+                cw = crop.width();
+                ch = crop.height();
+            }
+
+            // 2. Lay danh sach khuon mat
+            List<FaceBox> customList = readCustomFaces();
+            List<Face> faceList = new ArrayList<>();
+
+            int fx = 0, fy = 0, fw = 0, fh = 0;
+            if (customList != null && !customList.isEmpty()) {
+                int id = 1;
+                for (FaceBox fb : customList) {
+                    fx = fb.x; fy = fb.y; fw = fb.w; fh = fb.h;
+                    Point leftEye = new Point(fb.x + fb.w * 3 / 10, fb.y + fb.h * 35 / 100);
+                    Point rightEye = new Point(fb.x + fb.w * 7 / 10, fb.y + fb.h * 35 / 100);
+                    Point mouth = new Point(fb.x + fb.w / 2, fb.y + fb.h * 7 / 10);
+                    Face f = createFace(new Rect(fb.x, fb.y, fb.x + fb.w, fb.y + fb.h), fb.score, id++, leftEye, rightEye, mouth);
+                    if (f != null) faceList.add(f);
+                }
+            } else {
+                // Tinh toan tu dong theo Zoom / Pan cua Vcam (chuan theo native_hook)
+                float zoom = VcamConfig.getZoomScale();
+                if (zoom < 0.5f) zoom = 0.5f;
+                if (zoom > 5.0f) zoom = 5.0f;
+
+                float panX = VcamConfig.getPanX();
+                float panY = VcamConfig.getPanY();
+
+                int baseW = (int) (cw * 0.26f * zoom);
+                int baseH = (int) (ch * 0.42f * zoom);
+
+                // Pixel 4 sensor xoay 270 do so voi khung hinh doc
+                int shiftSensorX = (int) (panY * (cw * 0.35f));
+                int shiftSensorY = (int) (-panX * (ch * 0.35f));
+
+                int centerX = cx + cw / 2 + shiftSensorX;
+                int centerY = cy + ch / 2 + shiftSensorY;
+
+                fx = centerX - baseW / 2;
+                fy = centerY - baseH / 2;
+                fw = baseW;
+                fh = baseH;
+
+                if (fx < cx) fx = cx;
+                if (fy < cy) fy = cy;
+                if (fx + fw > cx + cw) fw = cx + cw - fx;
+                if (fy + fh > cy + ch) fh = cy + ch - fy;
+
+                Point leftEye = new Point(fx + fw * 3 / 10, fy + fh * 35 / 100);
+                Point rightEye = new Point(fx + fw * 7 / 10, fy + fh * 35 / 100);
+                Point mouth = new Point(fx + fw / 2, fy + fh * 7 / 10);
+
+                Face f = createFace(new Rect(fx, fy, fx + fw, fy + fh), 99, 1, leftEye, rightEye, mouth);
+                if (f != null) faceList.add(f);
+            }
+
+            Face[] faces = faceList.toArray(new Face[faceList.size()]);
+
+            // 3. Inject tat ca cac tag Face metadata chuan (dong bo theo face_metadata_hook.cpp)
+            result.set(CaptureResult.STATISTICS_FACE_DETECT_MODE, Integer.valueOf(CameraMetadata.STATISTICS_FACE_DETECT_MODE_FULL));
+            result.set(CaptureResult.STATISTICS_FACES, faces);
+
+            int n = faceList.size();
+            if (n > 0) {
+                Rect[] rects = new Rect[n];
+                byte[] scores = new byte[n];
+                int[] ids = new int[n];
+                int[] landmarks = new int[n * 6];
+
+                for (int i = 0; i < n; i++) {
+                    Face f = faceList.get(i);
+                    Rect b = f.getBounds();
+                    rects[i] = b;
+                    scores[i] = (byte) f.getScore();
+                    ids[i] = f.getId();
+
+                    Point le = f.getLeftEyePosition();
+                    Point re = f.getRightEyePosition();
+                    Point m = f.getMouthPosition();
+                    landmarks[i * 6 + 0] = (le != null) ? le.x : (b.left + b.width() * 3 / 10);
+                    landmarks[i * 6 + 1] = (le != null) ? le.y : (b.top + b.height() * 35 / 100);
+                    landmarks[i * 6 + 2] = (re != null) ? re.x : (b.left + b.width() * 7 / 10);
+                    landmarks[i * 6 + 3] = (re != null) ? re.y : (b.top + b.height() * 35 / 100);
+                    landmarks[i * 6 + 4] = (m != null) ? m.x : (b.left + b.width() / 2);
+                    landmarks[i * 6 + 5] = (m != null) ? m.y : (b.top + b.height() * 7 / 10);
+                }
+
+                result.set(CaptureResult.STATISTICS_FACE_RECTANGLES, rects);
+                result.set(CaptureResult.STATISTICS_FACE_SCORES, scores);
+                result.set(CaptureResult.STATISTICS_FACE_IDS, ids);
+                result.set(CaptureResult.STATISTICS_FACE_LANDMARKS, landmarks);
+            }
+
+            // 4. Inject Sensor, 3A Converged states & ISP stats (giup eKYC pass kiem tra do sang / on dinh)
+            updateSensorExposure();
+            result.set(CaptureResult.SENSOR_EXPOSURE_TIME, Long.valueOf(sCachedExpTime));
+            result.set(CaptureResult.SENSOR_SENSITIVITY, Integer.valueOf(sCachedIso));
+            result.set(CaptureResult.SENSOR_FRAME_DURATION, Long.valueOf(33333333L));
+            result.set(CaptureResult.CONTROL_POST_RAW_SENSITIVITY_BOOST, Integer.valueOf(100));
+            result.set(CaptureResult.COLOR_CORRECTION_MODE, Integer.valueOf(0)); // TRANSFORM_MATRIX
+            result.set(CaptureResult.CONTROL_AE_STATE, Integer.valueOf(CaptureResult.CONTROL_AE_STATE_CONVERGED));
+            result.set(CaptureResult.CONTROL_AWB_STATE, Integer.valueOf(CaptureResult.CONTROL_AWB_STATE_CONVERGED));
+            result.set(CaptureResult.CONTROL_SCENE_MODE, Integer.valueOf(CaptureResult.CONTROL_SCENE_MODE_FACE_PRIORITY));
+
+            long now = System.currentTimeMillis();
+            if (now - sLastLogTime > 3000) {
+                sLastLogTime = now;
+                Log.i(TAG, "Injected Face Metadata: count=" + n + ", rect=[" + fx + "," + fy + "," + fw + "," + fh + "]");
+            }
+
+        } catch (Throwable t) {
+            Log.w(TAG, "inject error: " + t);
+        }
+    }
+}
+
diff --git a/core/java/android/hardware/camera2/impl/VcamStillCapture.java b/core/java/android/hardware/camera2/impl/VcamStillCapture.java
new file mode 100644
--- /dev/null
+++ b/core/java/android/hardware/camera2/impl/VcamStillCapture.java
@@ -0,0 +1,270 @@
+package android.hardware.camera2.impl;
+
+import android.graphics.ImageFormat;
+import android.media.Image;
+import android.media.ImageReader;
+import android.util.Log;
+import java.nio.ByteBuffer;
+
+/**
+ * VcamStillCapture
+ *
+ * Intercepts ImageReader frames:
+ * 1. Still Photo Capture (Format JPEG 256 / BLOB 33): Injects 100% full-res JPEG snapshot.
+ * 2. Computer Vision / Face Recognition (Format YUV_420_888 35 / NV21 17):
+ *    Injects real-time live YUV frames directly into ImageReader ByteBuffers (< 0.5ms).
+ *    Optimized for Google ML Kit, OpenCV, and Banking KYC Face Recognition (BlazeFace).
+ *    Supports Sensor Orientation Mapping (Rotation 90/270 deg) for front/back cameras.
+ */
+public class VcamStillCapture {
+    private static final String TAG = "VCAM-StillCapture";
+    private static long sLastLogTime = 0;
+    private static long sLastInjectTime = 0;
+
+    // Fast precomputed LUT tables to eliminate runtime division/math in inner loops
+    private static int[] sLutSx = null;
+    private static int[] sLutSy = null;
+    private static int[] sLutUvSx = null;
+    private static int[] sLutUvSy = null;
+    private static int sLastDstW = 0, sLastDstH = 0, sLastSrcW = 0, sLastSrcH = 0;
+    private static boolean sLastRotate90CW = false;
+    private static byte[] sRowBuf = null;
+
+    public static void intercept(Image image, ImageReader reader) {
+        if (image == null || reader == null) return;
+        try {
+            if (!VcamLicenseVerifier.isLicenseActive() || VcamConfig.isVcamDisabled()) {
+                return;
+            }
+
+            int format = reader.getImageFormat();
+
+            // Case 1: JPEG / BLOB format (Format 256 / 0x100 or Format 33 / 0x21)
+            // Used for Still Photo Capture (takePicture)
+            if (format == ImageFormat.JPEG || format == 33 || format == 0x21 || format == 256) {
+                byte[] jpegBytes = VcamRenderer.getLatestSnapshotJpeg();
+                if (jpegBytes != null && jpegBytes.length > 0) {
+                    Image.Plane[] planes = image.getPlanes();
+                    if (planes != null && planes.length > 0) {
+                        ByteBuffer buf = planes[0].getBuffer();
+                        if (buf != null) {
+                            buf.clear();
+                            int toWrite = Math.min(jpegBytes.length, buf.capacity());
+                            buf.put(jpegBytes, 0, toWrite);
+                            buf.position(0);
+                            buf.limit(toWrite);
+                            Log.i(TAG, "Intercepted JPEG Still Capture! Injected " + toWrite + " bytes");
+                        }
+                    }
+                }
+                return;
+            }
+
+            // Case 2: YUV_420_888 (Format 35 / 0x23) or NV21 (Format 17 / 0x11)
+            // Used by Computer Vision / Face Recognition / Google ML Kit / OpenCV
+            if (format == ImageFormat.YUV_420_888 || format == 35 || format == 0x23 || format == 17) {
+                injectLiveYuv(image);
+                return;
+            }
+
+        } catch (Throwable t) {
+            Log.e(TAG, "VcamStillCapture intercept error: " + t.getMessage());
+        }
+    }
+
+    private static void injectLiveYuv(Image image) {
+        try {
+            long now = System.currentTimeMillis();
+            // Throttle to max 25 fps (~40ms interval) to completely prevent CPU ANR
+            if (now - sLastInjectTime < 40) {
+                return;
+            }
+            sLastInjectTime = now;
+
+            byte[] srcY = VcamRenderer.getLiveYData();
+            byte[] srcU = VcamRenderer.getLiveUData();
+            byte[] srcV = VcamRenderer.getLiveVData();
+            int srcW = VcamRenderer.getLiveYuvWidth();
+            int srcH = VcamRenderer.getLiveYuvHeight();
+
+            if (srcY == null || srcU == null || srcV == null || srcW <= 0 || srcH <= 0) {
+                return;
+            }
+
+            Image.Plane[] planes = image.getPlanes();
+            if (planes == null || planes.length < 3) return;
+
+            ByteBuffer yBuf = planes[0].getBuffer();
+            ByteBuffer uBuf = planes[1].getBuffer();
+            ByteBuffer vBuf = planes[2].getBuffer();
+            if (yBuf == null || uBuf == null || vBuf == null) return;
+
+            int dstW = image.getWidth();
+            int dstH = image.getHeight();
+            int yRowStride = planes[0].getRowStride();
+            int uRowStride = planes[1].getRowStride();
+            int vRowStride = planes[2].getRowStride();
+            int uPixStride = planes[1].getPixelStride();
+            int vPixStride = planes[2].getPixelStride();
+
+            // Detect if dst is landscape while src is portrait
+            // Pixel 4 Front camera sensor orientation = 270 deg.
+            // When ML Kit receives landscape 1920x1080 buffer, it applies 270 deg counter-clockwise rotation.
+            // To produce an upright face for BlazeFace/ML Kit, the buffer MUST be rotated 90 deg clockwise!
+            boolean needRotate90CW = (dstW > dstH);
+
+            // Recompute lookup tables only when dimensions change
+            if (sLastDstW != dstW || sLastDstH != dstH || sLastSrcW != srcW || sLastSrcH != srcH || sLastRotate90CW != needRotate90CW) {
+                sLastDstW = dstW;
+                sLastDstH = dstH;
+                sLastSrcW = srcW;
+                sLastSrcH = srcH;
+                sLastRotate90CW = needRotate90CW;
+                sRowBuf = new byte[dstW];
+
+                if (needRotate90CW) {
+                    sLutSx = new int[dstH];
+                    for (int r = 0; r < dstH; r++) {
+                        int sx = (r * srcW) / dstH;
+                        sLutSx[r] = Math.min(sx, srcW - 1);
+                    }
+                    sLutSy = new int[dstW];
+                    for (int c = 0; c < dstW; c++) {
+                        int sy = ((dstW - 1 - c) * srcH) / dstW;
+                        sLutSy[c] = Math.min(sy, srcH - 1);
+                    }
+                    int dstUvH = dstH / 2;
+                    int dstUvW = dstW / 2;
+                    int srcUvW = srcW / 2;
+                    int srcUvH = srcH / 2;
+                    sLutUvSx = new int[dstUvH];
+                    for (int r = 0; r < dstUvH; r++) {
+                        int sx = (r * srcUvW) / dstUvH;
+                        sLutUvSx[r] = Math.min(sx, srcUvW - 1);
+                    }
+                    sLutUvSy = new int[dstUvW];
+                    for (int c = 0; c < dstUvW; c++) {
+                        int sy = ((dstUvW - 1 - c) * srcUvH) / dstUvW;
+                        sLutUvSy[c] = Math.min(sy, srcUvH - 1);
+                    }
+                } else {
+                    sLutSy = new int[dstH];
+                    for (int r = 0; r < dstH; r++) {
+                        int sy = (r * srcH) / dstH;
+                        sLutSy[r] = Math.min(sy, srcH - 1);
+                    }
+                    sLutSx = new int[dstW];
+                    for (int c = 0; c < dstW; c++) {
+                        int sx = (c * srcW) / dstW;
+                        sLutSx[c] = Math.min(sx, srcW - 1);
+                    }
+                    int dstUvH = dstH / 2;
+                    int dstUvW = dstW / 2;
+                    int srcUvW = srcW / 2;
+                    int srcUvH = srcH / 2;
+                    sLutUvSy = new int[dstUvH];
+                    for (int r = 0; r < dstUvH; r++) {
+                        int sy = (r * srcUvH) / dstUvH;
+                        sLutUvSy[r] = Math.min(sy, srcUvH - 1);
+                    }
+                    sLutUvSx = new int[dstUvW];
+                    for (int c = 0; c < dstUvW; c++) {
+                        int sx = (c * srcUvW) / dstUvW;
+                        sLutUvSx[c] = Math.min(sx, srcUvW - 1);
+                    }
+                }
+            }
+
+            if (needRotate90CW) {
+                // Rotate 90 deg CW using fast precomputed 1D LUT
+                for (int r = 0; r < dstH; r++) {
+                    int dstPos = r * yRowStride;
+                    if (dstPos + dstW > yBuf.capacity()) break;
+                    int sx = sLutSx[r];
+
+                    for (int c = 0; c < dstW; c++) {
+                        sRowBuf[c] = srcY[sLutSy[c] * srcW + sx];
+                    }
+                    yBuf.position(dstPos);
+                    yBuf.put(sRowBuf, 0, dstW);
+                }
+
+                int dstUvH = dstH / 2;
+                int dstUvW = dstW / 2;
+                int srcUvW = srcW / 2;
+
+                for (int r = 0; r < dstUvH; r++) {
+                    int uRowPos = r * uRowStride;
+                    int vRowPos = r * vRowStride;
+                    int sx = sLutUvSx[r];
+
+                    for (int c = 0; c < dstUvW; c++) {
+                        int sy = sLutUvSy[c];
+                        int srcIdx = sy * srcUvW + sx;
+                        if (srcIdx >= srcU.length) break;
+
+                        int uPos = uRowPos + c * uPixStride;
+                        int vPos = vRowPos + c * vPixStride;
+                        if (uPos < uBuf.capacity()) uBuf.put(uPos, srcU[srcIdx]);
+                        if (vPos < vBuf.capacity()) vBuf.put(vPos, srcV[srcIdx]);
+                    }
+                }
+            } else {
+                // Direct mapping using fast precomputed 1D LUT
+                if (srcW == dstW) {
+                    for (int r = 0; r < dstH; r++) {
+                        int sy = sLutSy[r];
+                        int srcRowStart = sy * srcW;
+                        int dstPos = r * yRowStride;
+                        if (dstPos + dstW > yBuf.capacity()) break;
+                        yBuf.position(dstPos);
+                        yBuf.put(srcY, srcRowStart, dstW);
+                    }
+                } else {
+                    for (int r = 0; r < dstH; r++) {
+                        int sy = sLutSy[r];
+                        int srcRowStart = sy * srcW;
+                        int dstPos = r * yRowStride;
+                        if (dstPos + dstW > yBuf.capacity()) break;
+
+                        for (int c = 0; c < dstW; c++) {
+                            sRowBuf[c] = srcY[srcRowStart + sLutSx[c]];
+                        }
+                        yBuf.position(dstPos);
+                        yBuf.put(sRowBuf, 0, dstW);
+                    }
+                }
+
+                int dstUvH = dstH / 2;
+                int dstUvW = dstW / 2;
+                int srcUvW = srcW / 2;
+
+                for (int r = 0; r < dstUvH; r++) {
+                    int sy = sLutUvSy[r];
+                    int srcUvRowStart = sy * srcUvW;
+                    int uRowPos = r * uRowStride;
+                    int vRowPos = r * vRowStride;
+
+                    for (int c = 0; c < dstUvW; c++) {
+                        int sx = sLutUvSx[c];
+                        int srcIdx = srcUvRowStart + sx;
+                        if (srcIdx >= srcU.length) break;
+
+                        int uPos = uRowPos + c * uPixStride;
+                        int vPos = vRowPos + c * vPixStride;
+                        if (uPos < uBuf.capacity()) uBuf.put(uPos, srcU[srcIdx]);
+                        if (vPos < vBuf.capacity()) vBuf.put(vPos, srcV[srcIdx]);
+                    }
+                }
+            }
+
+            if (now - sLastLogTime > 3000) {
+                sLastLogTime = now;
+                Log.i(TAG, "Successfully injected Live YUV frame (" + dstW + "x" + dstH + ", rotated90CW=" + needRotate90CW + ") for Face ML!");
+            }
+
+        } catch (Throwable t) {
+            Log.w(TAG, "injectLiveYuv error: " + t.getMessage());
+        }
+    }
+}
diff --git a/core/java/android/hardware/camera2/impl/VcamLiveFeedShm.java b/core/java/android/hardware/camera2/impl/VcamLiveFeedShm.java
new file mode 100644
--- /dev/null
+++ b/core/java/android/hardware/camera2/impl/VcamLiveFeedShm.java
@@ -0,0 +1,252 @@
+package android.hardware.camera2.impl;
+
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.util.Log;
+import android.view.Surface;
+
+import java.io.File;
+import java.io.RandomAccessFile;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.MappedByteBuffer;
+import java.nio.channels.FileChannel;
+
+/**
+ * VcamLiveFeedShm: Zero-latency Shared Memory Live Video Stream Reader.
+ * Reads double-buffered NV12 frames from /data/local/tmp/vcam_live.shm
+ * (written by OBS USB Stream Receiver or Camera Assistant).
+ *
+ * Provides:
+ *  - 0ms latency video preview injection
+ *  - Direct YUV 420 feeding for Google ML Kit / BlazeFace Face Detection
+ *  - Auto fallback when live stream ends
+ */
+public class VcamLiveFeedShm {
+    private static final String TAG = "VCAM_LIVE_SHM";
+
+    public static final String SHM_FILE = "/data/local/tmp/vcam_live.shm";
+    public static final String ALT_SHM_FILE = "/sdcard/CameraAssistant/vcam_live.shm";
+
+    public static final int VCAM_SHM_MAGIC = 0x5643414D; // 'VCAM'
+    public static final int VCAM_SHM_VERSION = 1;
+
+    public static final int MAX_WIDTH = 1920;
+    public static final int MAX_HEIGHT = 1920;
+    public static final int MAX_FRAME_SIZE = MAX_WIDTH * MAX_HEIGHT * 3 / 2; // 5,529,600 bytes
+    public static final int HEADER_SIZE = 112;
+    public static final int TOTAL_SHM_SIZE = HEADER_SIZE + 2 * MAX_FRAME_SIZE; // 11,059,312 bytes
+
+    private static final int BUFFER_0_OFFSET = HEADER_SIZE;
+    private static final int BUFFER_1_OFFSET = HEADER_SIZE + MAX_FRAME_SIZE;
+
+    public interface StopCondition {
+        boolean shouldStop();
+    }
+
+    private static File getActiveShmFile() {
+        File f = new File(SHM_FILE);
+        if (f.exists() && f.length() >= HEADER_SIZE && f.canRead()) {
+            return f;
+        }
+        File alt = new File(ALT_SHM_FILE);
+        if (alt.exists() && alt.length() >= HEADER_SIZE && alt.canRead()) {
+            return alt;
+        }
+        return null;
+    }
+
+    /**
+     * Checks if Live Feed SHM has active frames written recently (< 3 seconds).
+     */
+    public static boolean isStreamingActive() {
+        File f = getActiveShmFile();
+        if (f == null) return false;
+
+        try {
+            RandomAccessFile raf = new RandomAccessFile(f, "r");
+            byte[] headerBytes = new byte[48];
+            int read = raf.read(headerBytes);
+            raf.close();
+            if (read < 48) return false;
+
+            ByteBuffer buf = ByteBuffer.wrap(headerBytes);
+            buf.order(ByteOrder.LITTLE_ENDIAN);
+            int magic = buf.getInt();         // +0
+            int version = buf.getInt();       // +4
+            int width = buf.getInt();         // +8
+            int height = buf.getInt();        // +12
+            buf.position(40);
+            long tsMs = buf.getLong();        // +40
+
+            if (magic == VCAM_SHM_MAGIC && width > 0 && height > 0) {
+                long now = System.currentTimeMillis();
+                long diff = Math.abs(now - tsMs);
+                return (diff < 3000); // 3 seconds timeout
+            }
+        } catch (Throwable ignored) {}
+        return false;
+    }
+
+    /**
+     * Plays the live SHM stream onto decodeSurface & drives VcamRenderer.
+     * Blocks while stream is active. Exits when stream times out or shouldStop() is true.
+     */
+    public static void playStream(Surface decodeSurface, VcamRenderer renderer, StopCondition stopCondition) {
+        File f = getActiveShmFile();
+        if (f == null) return;
+
+        Log.i(TAG, "Starting Live Feed SHM playback onto surface...");
+        RandomAccessFile raf = null;
+        FileChannel channel = null;
+        MappedByteBuffer shm = null;
+
+        Bitmap bitmap = null;
+        int[] rgbPixels = null;
+        byte[] frameNv12 = null;
+        Paint paint = new Paint(Paint.FILTER_BITMAP_FLAG);
+
+        try {
+            raf = new RandomAccessFile(f, "r");
+            channel = raf.getChannel();
+            long size = channel.size();
+            if (size < TOTAL_SHM_SIZE) {
+                Log.w(TAG, "SHM file size too small: " + size);
+                return;
+            }
+            shm = channel.map(FileChannel.MapMode.READ_ONLY, 0, TOTAL_SHM_SIZE);
+            shm.order(ByteOrder.LITTLE_ENDIAN);
+
+            int lastFrameIndex = -1;
+            long lastActiveTime = System.currentTimeMillis();
+
+            while (!stopCondition.shouldStop() && decodeSurface.isValid()) {
+                int magic = shm.getInt(0);
+                if (magic != VCAM_SHM_MAGIC) {
+                    break;
+                }
+
+                long tsMs = shm.getLong(40);
+                long now = System.currentTimeMillis();
+                if (Math.abs(now - tsMs) > 3000) {
+                    Log.i(TAG, "Live Feed SHM stream timed out (> 3000ms). Returning to offline.");
+                    break;
+                }
+
+                int frameIndex = shm.getInt(32);
+                if (frameIndex != lastFrameIndex) {
+                    lastFrameIndex = frameIndex;
+                    lastActiveTime = now;
+
+                    int width = shm.getInt(8);
+                    int height = shm.getInt(12);
+                    int stride = shm.getInt(16);
+                    if (stride < width) stride = width;
+                    int sliceHeight = shm.getInt(20);
+                    if (sliceHeight < height) sliceHeight = height;
+
+                    int activeBuf = shm.getInt(36);
+                    if (activeBuf < 0 || activeBuf > 1) activeBuf = 0;
+
+                    int frameSize = stride * sliceHeight * 3 / 2;
+                    if (frameSize > MAX_FRAME_SIZE) frameSize = MAX_FRAME_SIZE;
+
+                    int bufOffset = (activeBuf == 1) ? BUFFER_1_OFFSET : BUFFER_0_OFFSET;
+
+                    if (frameNv12 == null || frameNv12.length != frameSize) {
+                        frameNv12 = new byte[frameSize];
+                    }
+
+                    shm.position(bufOffset);
+                    shm.get(frameNv12, 0, frameSize);
+
+                    // 1. Direct NV12 update for BlazeFace / ML Kit (sLiveY, sLiveU, sLiveV)
+                    VcamRenderer.updateLiveYuvFromNv12(frameNv12, width, height, stride);
+
+                    // 2. Render onto decodeSurface for OpenGL pipeline
+                    if (bitmap == null || bitmap.getWidth() != width || bitmap.getHeight() != height) {
+                        bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888);
+                        rgbPixels = new int[width * height];
+                    }
+
+                    fastNv12ToRgb(frameNv12, rgbPixels, width, height, stride);
+                    bitmap.setPixels(rgbPixels, 0, width, 0, 0, width, height);
+
+                    Canvas canvas = null;
+                    try {
+                        canvas = decodeSurface.lockHardwareCanvas();
+                        if (canvas != null) {
+                            Rect src = new Rect(0, 0, width, height);
+                            Rect dst = new Rect(0, 0, canvas.getWidth(), canvas.getHeight());
+                            canvas.drawBitmap(bitmap, src, dst, paint);
+                        }
+                    } catch (Throwable t) {
+                        try {
+                            canvas = decodeSurface.lockCanvas(null);
+                            if (canvas != null) {
+                                Rect src = new Rect(0, 0, width, height);
+                                Rect dst = new Rect(0, 0, canvas.getWidth(), canvas.getHeight());
+                                canvas.drawBitmap(bitmap, src, dst, paint);
+                            }
+                        } catch (Throwable ignored) {}
+                    } finally {
+                        if (canvas != null) {
+                            try {
+                                decodeSurface.unlockCanvasAndPost(canvas);
+                            } catch (Throwable ignored) {}
+                        }
+                    }
+
+                    if (renderer != null && renderer.isInitialized()) {
+                        renderer.renderFrame();
+                    }
+                }
+
+                try {
+                    Thread.sleep(8); // ~120Hz polling matching native hook
+                } catch (InterruptedException e) {
+                    break;
+                }
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "playStream error: " + t.getMessage(), t);
+        } finally {
+            if (channel != null) {
+                try { channel.close(); } catch (Throwable ignored) {}
+            }
+            if (raf != null) {
+                try { raf.close(); } catch (Throwable ignored) {}
+            }
+        }
+    }
+
+    /**
+     * Fast NV12 to RGB converter.
+     */
+    private static void fastNv12ToRgb(byte[] nv12, int[] rgb, int width, int height, int stride) {
+        int uvOffset = stride * height;
+        for (int y = 0; y < height; y++) {
+            int yRow = y * stride;
+            int uvRow = (y >> 1) * stride;
+            int outRow = y * width;
+            for (int x = 0; x < width; x++) {
+                int Y = nv12[yRow + x] & 0xFF;
+                int uvIdx = uvOffset + uvRow + (x & ~1);
+                int U = (nv12[uvIdx] & 0xFF) - 128;
+                int V = (nv12[uvIdx + 1] & 0xFF) - 128;
+
+                int r = Y + ((359 * V) >> 8);
+                int g = Y - ((88 * U + 183 * V) >> 8);
+                int b = Y + ((454 * U) >> 8);
+
+                if (r < 0) r = 0; else if (r > 255) r = 255;
+                if (g < 0) g = 0; else if (g > 255) g = 255;
+                if (b < 0) b = 0; else if (b > 255) b = 255;
+
+                rgb[outRow + x] = 0xFF000000 | (r << 16) | (g << 8) | b;
+            }
+        }
+    }
+}
