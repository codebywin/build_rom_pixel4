diff --git a/core/java/android/hardware/camera2/impl/VcamEngine.java b/core/java/android/hardware/camera2/impl/VcamEngine.java
new file mode 100644
--- /dev/null
+++ b/core/java/android/hardware/camera2/impl/VcamEngine.java
@@ -0,0 +1,348 @@
+package android.hardware.camera2.impl;
+
+import android.graphics.SurfaceTexture;
+import android.hardware.camera2.CameraDevice;
+import android.hardware.camera2.CaptureRequest;
+import android.hardware.camera2.params.OutputConfiguration;
+import android.media.MediaCodec;
+import android.media.MediaExtractor;
+import android.media.MediaFormat;
+import android.util.ArraySet;
+import android.util.Log;
+import android.view.Surface;
+import java.io.File;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+public class VcamEngine {
+    private static final String TAG = "VCAM";
+    private static final String DISABLE_FLAG = "/sdcard/vcam_disable";
+    private static final String[] VIDEO_PATHS = new String[] {
+        "/sdcard/vcam.mp4",
+        "/sdcard/DCIM/Camera/vcam.mp4",
+        "/data/local/tmp/vcam.mp4"
+    };
+
+    private static class VideoPlayer implements Runnable {
+        final File file;
+        final Surface realSurface;
+        final int targetWidth;
+        final int targetHeight;
+        volatile boolean running = true;
+        Thread thread;
+
+        VideoPlayer(File file, Surface surface, int width, int height) {
+            this.file = file;
+            this.realSurface = surface;
+            this.targetWidth = width;
+            this.targetHeight = height;
+        }
+
+        void start() {
+            thread = new Thread(this, "VCAM-MediaCodec");
+            thread.start();
+        }
+
+        void stop() {
+            running = false;
+            if (thread != null) {
+                thread.interrupt();
+            }
+        }
+
+        @Override
+        public void run() {
+            Log.i(TAG, "MediaCodec video decoder thread started for: " + file.getAbsolutePath());
+            while (running) {
+                MediaExtractor extractor = null;
+                MediaCodec decoder = null;
+                VcamRenderer renderer = null;
+                try {
+                    extractor = new MediaExtractor();
+                    extractor.setDataSource(file.getAbsolutePath());
+
+                    int videoTrackIndex = -1;
+                    MediaFormat format = null;
+                    int numTracks = extractor.getTrackCount();
+                    for (int i = 0; i < numTracks; i++) {
+                        MediaFormat mf = extractor.getTrackFormat(i);
+                        String mime = mf.getString(MediaFormat.KEY_MIME);
+                        if (mime != null && mime.startsWith("video/")) {
+                            videoTrackIndex = i;
+                            format = mf;
+                            break;
+                        }
+                    }
+
+                    if (videoTrackIndex < 0 || format == null) {
+                        Log.e(TAG, "No video track found in " + file.getAbsolutePath());
+                        return;
+                    }
+
+                    extractor.selectTrack(videoTrackIndex);
+                    String mime = format.getString(MediaFormat.KEY_MIME);
+                    decoder = MediaCodec.createDecoderByType(mime);
+
+                    Surface decodeSurface = realSurface;
+                    try {
+                        renderer = new VcamRenderer();
+                        if (renderer.init(realSurface, targetWidth, targetHeight)) {
+                            decodeSurface = renderer.getInputSurface();
+                            Log.i(TAG, "VcamRenderer EGL pipeline active (" + targetWidth + "x" + targetHeight + ")");
+                        } else {
+                            renderer.release();
+                            renderer = null;
+                        }
+                    } catch (Throwable t) {
+                        Log.w(TAG, "VcamRenderer init failed, fallback to direct surface: " + t);
+                        if (renderer != null) {
+                            renderer.release();
+                            renderer = null;
+                        }
+                    }
+
+                    decoder.configure(format, decodeSurface, null, 0);
+                    decoder.start();
+
+                    int fps = 30;
+                    if (format.containsKey(MediaFormat.KEY_FRAME_RATE)) {
+                        try {
+                            fps = format.getInteger(MediaFormat.KEY_FRAME_RATE);
+                            if (fps <= 0 || fps > 60) fps = 30;
+                        } catch (Throwable ignored) {}
+                    }
+                    long frameDelayMs = 1000 / fps;
+
+                    MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+                    long nextFrameTimeMs = System.currentTimeMillis();
+                    long basePtsUs = 0;
+                    long lastSampleTimeUs = 0;
+
+                    while (running && decodeSurface != null && decodeSurface.isValid()) {
+                        while (running && VcamConfig.isPaused()) {
+                            try {
+                                if (renderer != null) {
+                                    renderer.renderFrame();
+                                }
+                                Thread.sleep(80);
+                            } catch (InterruptedException ie) {
+                                break;
+                            }
+                        }
+
+                        int inIndex = decoder.dequeueInputBuffer(10000);
+                        if (inIndex >= 0) {
+                            ByteBuffer buffer = decoder.getInputBuffer(inIndex);
+                            int sampleSize = extractor.readSampleData(buffer, 0);
+                            if (sampleSize < 0) {
+                                extractor.seekTo(0, MediaExtractor.SEEK_TO_CLOSEST_SYNC);
+                                basePtsUs += lastSampleTimeUs + 33333;
+                                sampleSize = extractor.readSampleData(buffer, 0);
+                            }
+
+                            if (sampleSize >= 0) {
+                                long sampleTime = extractor.getSampleTime();
+                                if (sampleTime > 0) {
+                                    lastSampleTimeUs = sampleTime;
+                                }
+                                decoder.queueInputBuffer(inIndex, 0, sampleSize, basePtsUs + sampleTime, 0);
+                                extractor.advance();
+                            }
+                        }
+
+                        int outIndex = decoder.dequeueOutputBuffer(info, 10000);
+                        if (outIndex >= 0) {
+                            long now = System.currentTimeMillis();
+                            if (now < nextFrameTimeMs) {
+                                long sleepMs = nextFrameTimeMs - now;
+                                if (sleepMs > 0 && sleepMs < 100) {
+                                    try {
+                                        Thread.sleep(sleepMs);
+                                    } catch (InterruptedException ie) {
+                                        break;
+                                    }
+                                }
+                            }
+                            nextFrameTimeMs = System.currentTimeMillis() + frameDelayMs;
+                            try {
+                                decoder.releaseOutputBuffer(outIndex, true);
+                                if (renderer != null) {
+                                    renderer.renderFrame();
+                                }
+                            } catch (Throwable e) {
+                                Log.w(TAG, "releaseOutputBuffer dropped frame: " + e.getMessage());
+                            }
+                        }
+                    }
+                } catch (Throwable t) {
+                    if (running) {
+                        Log.e(TAG, "MediaCodec playback loop error: " + t.getMessage(), t);
+                    }
+                } finally {
+                    if (decoder != null) {
+                        try {
+                            decoder.stop();
+                            decoder.release();
+                        } catch (Throwable ignored) {}
+                    }
+                    if (extractor != null) {
+                        try {
+                            extractor.release();
+                        } catch (Throwable ignored) {}
+                    }
+                    if (renderer != null) {
+                        try {
+                            renderer.release();
+                        } catch (Throwable ignored) {}
+                    }
+                    if (running) {
+                        try {
+                            Thread.sleep(50);
+                        } catch (InterruptedException ignored) {
+                            break;
+                        }
+                    }
+                }
+                Log.i(TAG, "MediaCodec video decoder thread finished.");
+            }
+        }
+    }
+
+    private static final Map<CameraDevice, VideoPlayer> sPlayers = new ConcurrentHashMap<>();
+    private static final Map<CameraDevice, Surface> sRealSurfaces = new ConcurrentHashMap<>();
+    private static final Map<CameraDevice, SurfaceTexture> sDummyTextures = new ConcurrentHashMap<>();
+    private static final Map<Surface, Surface> sRealToDummy = new ConcurrentHashMap<>();
+    private static final Map<CameraDevice, int[]> sSurfaceSizes = new ConcurrentHashMap<>();
+
+    private static File getActiveVideoFile() {
+        return VcamConfig.getActiveVideoFile();
+    }
+
+    public static void prepareOutputs(final CameraDevice device, final List<OutputConfiguration> outputs) {
+        try {
+            final File videoFile = getActiveVideoFile();
+            if (videoFile == null || outputs == null || outputs.isEmpty()) {
+                return;
+            }
+
+            cleanupPlayer(device);
+
+            for (OutputConfiguration config : outputs) {
+                if (config != null && config.getSurface() != null && config.getSurface().isValid()) {
+                    Surface realSurface = config.getSurface();
+                    try {
+                        int width = 1280;
+                        int height = 720;
+                        try {
+                            Method mw = OutputConfiguration.class.getDeclaredMethod("getWidth");
+                            Method mh = OutputConfiguration.class.getDeclaredMethod("getHeight");
+                            width = ((Number) mw.invoke(config)).intValue();
+                            height = ((Number) mh.invoke(config)).intValue();
+                        } catch (Throwable ignored) {}
+
+                        SurfaceTexture dummyTex = new SurfaceTexture(10);
+                        dummyTex.setDefaultBufferSize(width, height);
+                        Surface dummySurf = new Surface(dummyTex);
+
+                        Field f = OutputConfiguration.class.getDeclaredField("mSurfaces");
+                        f.setAccessible(true);
+                        ArrayList<Surface> surfaces = (ArrayList<Surface>) f.get(config);
+                        if (surfaces != null && !surfaces.isEmpty()) {
+                            surfaces.set(0, dummySurf);
+                            sRealSurfaces.put(device, realSurface);
+                            sDummyTextures.put(device, dummyTex);
+                            sRealToDummy.put(realSurface, dummySurf);
+                            sSurfaceSizes.put(device, new int[] { width, height });
+                            Log.i(TAG, "Replaced HAL surface with dummy to avoid BufferQueue conflict!");
+                            break;
+                        }
+                    } catch (Throwable t) {
+                        Log.e(TAG, "Failed to replace surface in config: " + t);
+                    }
+                }
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "prepareOutputs error: " + t);
+        }
+    }
+
+    public static void filterCaptureRequest(CaptureRequest request) {
+        if (request == null || sRealToDummy.isEmpty()) return;
+        try {
+            Field f = CaptureRequest.class.getDeclaredField("mSurfaceSet");
+            f.setAccessible(true);
+            ArraySet<Surface> set = (ArraySet<Surface>) f.get(request);
+            if (set != null) {
+                for (Map.Entry<Surface, Surface> entry : sRealToDummy.entrySet()) {
+                    if (set.contains(entry.getKey())) {
+                        set.remove(entry.getKey());
+                        set.add(entry.getValue());
+                    }
+                }
+            }
+        } catch (Throwable ignored) {}
+    }
+
+    public static void onSessionConfigured(final CameraDevice device, final List<OutputConfiguration> outputs) {
+        try {
+            final File videoFile = getActiveVideoFile();
+            if (videoFile == null) {
+                return;
+            }
+
+            Surface realSurface = sRealSurfaces.get(device);
+            if (realSurface == null && outputs != null) {
+                for (OutputConfiguration config : outputs) {
+                    if (config != null && config.getSurface() != null && config.getSurface().isValid()) {
+                        realSurface = config.getSurface();
+                        break;
+                    }
+                }
+            }
+
+            if (realSurface == null) {
+                Log.w(TAG, "No valid target surface found for VCAM playback");
+                return;
+            }
+
+            int[] size = sSurfaceSizes.get(device);
+            int width = (size != null) ? size[0] : 1280;
+            int height = (size != null) ? size[1] : 720;
+
+            VideoPlayer player = new VideoPlayer(videoFile, realSurface, width, height);
+            sPlayers.put(device, player);
+            player.start();
+
+        } catch (Throwable t) {
+            Log.e(TAG, "VCAM onSessionConfigured error: " + t);
+        }
+    }
+
+    public static void onCameraClose(CameraDevice device) {
+        cleanupPlayer(device);
+    }
+
+    private static void cleanupPlayer(CameraDevice device) {
+        if (device == null) return;
+        VideoPlayer player = sPlayers.remove(device);
+        if (player != null) {
+            player.stop();
+        }
+        Surface real = sRealSurfaces.remove(device);
+        if (real != null) {
+            sRealToDummy.remove(real);
+        }
+        SurfaceTexture dummyTex = sDummyTextures.remove(device);
+        if (dummyTex != null) {
+            try {
+                dummyTex.release();
+            } catch (Throwable ignored) {}
+        }
+        sSurfaceSizes.remove(device);
+    }
+}
