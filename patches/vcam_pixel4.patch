+    private static int loadShader(int shaderType, String source) {
+        int shader = GLES20.glCreateShader(shaderType);
+        if (shader != 0) {
+            GLES20.glShaderSource(shader, source);
+            GLES20.glCompileShader(shader);
+            int[] compiled = new int[1];
+            GLES20.glGetShaderiv(shader, GLES20.GL_COMPILE_STATUS, compiled, 0);
+            if (compiled[0] == 0) {
+                Log.e(TAG, "Could not compile shader " + shaderType + ": " + GLES20.glGetShaderInfoLog(shader));
+                GLES20.glDeleteShader(shader);
+                shader = 0;
+            }
+        }
+        return shader;
+    }
+
+    private static int createProgram(String vertexSource, String fragmentSource) {
+        int vertexShader = loadShader(GLES20.GL_VERTEX_SHADER, vertexSource);
+        if (vertexShader == 0) return 0;
+        int pixelShader = loadShader(GLES20.GL_FRAGMENT_SHADER, fragmentSource);
+        if (pixelShader == 0) return 0;
+
+        int program = GLES20.glCreateProgram();
+        if (program != 0) {
+            GLES20.glAttachShader(program, vertexShader);
+            GLES20.glAttachShader(program, pixelShader);
+            GLES20.glLinkProgram(program);
+            int[] linkStatus = new int[1];
+            GLES20.glGetProgramiv(program, GLES20.GL_LINK_STATUS, linkStatus, 0);
+            if (linkStatus[0] != GLES20.GL_TRUE) {
+                Log.e(TAG, "Could not link program: " + GLES20.glGetProgramInfoLog(program));
+                GLES20.glDeleteProgram(program);
+                program = 0;
+            }
+        }
+        return program;
+    }
+
+    private void captureSnapshotInternal(int w, int h) {
+        try {
+            if (w <= 0 || h <= 0) return;
+            ByteBuffer buf = ByteBuffer.allocateDirect(w * h * 4);
+            buf.order(ByteOrder.nativeOrder());
+            GLES20.glReadPixels(0, 0, w, h, GLES20.GL_RGBA, GLES20.GL_UNSIGNED_BYTE, buf);
+
+            Bitmap bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+            bmp.copyPixelsFromBuffer(buf);
+
+            // Vertical flip because glReadPixels origin is at bottom-left
+            android.graphics.Matrix flipMatrix = new android.graphics.Matrix();
+            flipMatrix.postScale(1.0f, -1.0f);
+            Bitmap flipped = Bitmap.createBitmap(bmp, 0, 0, w, h, flipMatrix, true);
+            bmp.recycle();
+
+            ByteArrayOutputStream baos = new ByteArrayOutputStream();
+            flipped.compress(Bitmap.CompressFormat.JPEG, 95, baos);
+            flipped.recycle();
+
+            sLatestSnapshotJpeg = baos.toByteArray();
+        } catch (Throwable t) {
+            Log.w(TAG, "captureSnapshotInternal error: " + t.getMessage());
+        }
+    }
+
+    public static byte[] getLatestSnapshotJpeg() {
+        byte[] snap = sLatestSnapshotJpeg;
+        if (snap != null) return snap;
+        sSnapshotRequested = true;
+        for (int i = 0; i < 8; i++) {
+            try {
+                Thread.sleep(20);
+            } catch (InterruptedException ignored) {}
+            snap = sLatestSnapshotJpeg;
+            if (snap != null) return snap;
+        }
+        return null;
+    }
+
+    public static void requestSnapshot() {
+        sSnapshotRequested = true;
+    }
