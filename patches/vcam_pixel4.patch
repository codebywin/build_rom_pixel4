diff --git a/core/java/android/hardware/camera2/impl/VcamEngine.java b/core/java/android/hardware/camera2/impl/VcamEngine.java
new file mode 100644
--- /dev/null
+++ b/core/java/android/hardware/camera2/impl/VcamEngine.java
@@ -0,0 +1,180 @@
+package android.hardware.camera2.impl;
+
+import android.graphics.SurfaceTexture;
+import android.hardware.camera2.CameraDevice;
+import android.hardware.camera2.CaptureRequest;
+import android.hardware.camera2.params.OutputConfiguration;
+import android.media.MediaPlayer;
+import android.util.ArraySet;
+import android.util.Log;
+import android.view.Surface;
+import java.io.File;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+public class VcamEngine {
+    private static final String TAG = "VCAM";
+    private static final String DISABLE_FLAG = "/sdcard/vcam_disable";
+    private static final String[] VIDEO_PATHS = new String[] {
+        "/sdcard/vcam.mp4",
+        "/sdcard/DCIM/Camera/vcam.mp4",
+        "/data/local/tmp/vcam.mp4"
+    };
+
+    private static final Map<CameraDevice, MediaPlayer> sPlayers = new ConcurrentHashMap<>();
+    private static final Map<CameraDevice, Surface> sRealSurfaces = new ConcurrentHashMap<>();
+    private static final Map<CameraDevice, SurfaceTexture> sDummyTextures = new ConcurrentHashMap<>();
+    private static final Map<Surface, Surface> sRealToDummy = new ConcurrentHashMap<>();
+
+    private static File getActiveVideoFile() {
+        if (new File(DISABLE_FLAG).exists()) {
+            return null;
+        }
+        for (String path : VIDEO_PATHS) {
+            File f = new File(path);
+            if (f.exists() && f.length() > 0 && f.canRead()) {
+                return f;
+            }
+        }
+        return null;
+    }
+
+    public static void prepareOutputs(final CameraDevice device, final List<OutputConfiguration> outputs) {
+        try {
+            final File videoFile = getActiveVideoFile();
+            if (videoFile == null || outputs == null || outputs.isEmpty()) {
+                return;
+            }
+
+            cleanupPlayer(device);
+
+            for (OutputConfiguration config : outputs) {
+                if (config != null && config.getSurface() != null && config.getSurface().isValid()) {
+                    Surface realSurface = config.getSurface();
+                    try {
+                        int width = 1280;
+                        int height = 720;
+                        try {
+                            Method mw = OutputConfiguration.class.getDeclaredMethod("getWidth");
+                            Method mh = OutputConfiguration.class.getDeclaredMethod("getHeight");
+                            width = ((Number) mw.invoke(config)).intValue();
+                            height = ((Number) mh.invoke(config)).intValue();
+                        } catch (Throwable ignored) {}
+
+                        SurfaceTexture dummyTex = new SurfaceTexture(10);
+                        dummyTex.setDefaultBufferSize(width, height);
+                        Surface dummySurf = new Surface(dummyTex);
+
+                        Field f = OutputConfiguration.class.getDeclaredField("mSurfaces");
+                        f.setAccessible(true);
+                        ArrayList<Surface> surfaces = (ArrayList<Surface>) f.get(config);
+                        if (surfaces != null && !surfaces.isEmpty()) {
+                            surfaces.set(0, dummySurf);
+                            sRealSurfaces.put(device, realSurface);
+                            sDummyTextures.put(device, dummyTex);
+                            sRealToDummy.put(realSurface, dummySurf);
+                            Log.i(TAG, "Replaced HAL surface with dummy to avoid BufferQueue conflict!");
+                            break;
+                        }
+                    } catch (Throwable t) {
+                        Log.e(TAG, "Failed to replace surface in config: " + t);
+                    }
+                }
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "prepareOutputs error: " + t);
+        }
+    }
+
+    public static void filterCaptureRequest(CaptureRequest request) {
+        if (request == null || sRealToDummy.isEmpty()) return;
+        try {
+            Field f = CaptureRequest.class.getDeclaredField("mSurfaceSet");
+            f.setAccessible(true);
+            ArraySet<Surface> set = (ArraySet<Surface>) f.get(request);
+            if (set != null) {
+                for (Map.Entry<Surface, Surface> entry : sRealToDummy.entrySet()) {
+                    if (set.contains(entry.getKey())) {
+                        set.remove(entry.getKey());
+                        set.add(entry.getValue());
+                    }
+                }
+            }
+        } catch (Throwable ignored) {}
+    }
+
+    public static void onSessionConfigured(final CameraDevice device, final List<OutputConfiguration> outputs) {
+        try {
+            final File videoFile = getActiveVideoFile();
+            if (videoFile == null) {
+                return;
+            }
+
+            Surface realSurface = sRealSurfaces.remove(device);
+            if (realSurface == null && outputs != null) {
+                for (OutputConfiguration config : outputs) {
+                    if (config != null && config.getSurface() != null && config.getSurface().isValid()) {
+                        realSurface = config.getSurface();
+                        break;
+                    }
+                }
+            }
+
+            if (realSurface == null) {
+                Log.w(TAG, "No valid target surface found for VCAM playback");
+                return;
+            }
+
+            final Surface surfaceToPlay = realSurface;
+            new Thread(new Runnable() {
+                @Override
+                public void run() {
+                    try {
+                        Thread.sleep(150);
+                        MediaPlayer mp = new MediaPlayer();
+                        mp.setDataSource(videoFile.getAbsolutePath());
+                        mp.setSurface(surfaceToPlay);
+                        mp.setLooping(true);
+                        mp.setVolume(0.0f, 0.0f);
+                        mp.prepare();
+                        mp.start();
+                        sPlayers.put(device, mp);
+                        Log.i(TAG, "VCAM playback successfully started for: " + videoFile.getAbsolutePath());
+                    } catch (Throwable t) {
+                        Log.e(TAG, "VCAM playback failed: ", t);
+                    }
+                }
+            }).start();
+
+        } catch (Throwable t) {
+            Log.e(TAG, "VCAM onSessionConfigured error: " + t);
+        }
+    }
+
+    public static void onCameraClose(CameraDevice device) {
+        cleanupPlayer(device);
+    }
+
+    private static void cleanupPlayer(CameraDevice device) {
+        if (device == null) return;
+        MediaPlayer mp = sPlayers.remove(device);
+        if (mp != null) {
+            try {
+                if (mp.isPlaying()) {
+                    mp.stop();
+                }
+                mp.release();
+            } catch (Throwable ignored) {}
+        }
+        Surface real = sRealSurfaces.remove(device);
+        if (real != null) {
+            sRealToDummy.remove(real);
+        }
+        SurfaceTexture dummyTex = sDummyTextures.remove(device);
+        if (dummyTex != null) {
+            try {
+                dummyTex.release();
+            } catch (Throwable ignored) {}
+        }
+    }
+}
diff --git a/media/java/android/media/VcamAudioEngine.java b/media/java/android/media/VcamAudioEngine.java
new file mode 100644
--- /dev/null
+++ b/media/java/android/media/VcamAudioEngine.java
@@ -0,0 +1,388 @@
+package android.media;
+
+import android.util.Log;
+import java.io.File;
+import java.io.RandomAccessFile;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+public class VcamAudioEngine {
+    private static final String TAG = "VCAM_AUDIO";
+    private static final String DISABLE_FLAG = "/sdcard/vcam_mic_disable";
+    private static final String[] AUDIO_PATHS = new String[] {
+        "/data/local/tmp/vcam.wav",
+        "/data/local/tmp/vcam.pcm",
+        "/sdcard/vcam.wav",
+        "/sdcard/vcam.pcm"
+    };
+
+    private static long sLastRealMicLogTime = 0;
+    private static float sBoostFactor = 1.0f;
+    private static long sLastBoostCheckTime = 0;
+
+    private static float getBoostFactor() {
+        long now = System.currentTimeMillis();
+        if (now - sLastBoostCheckTime > 2000) {
+            sLastBoostCheckTime = now;
+            File f = new File("/sdcard/vcam_mic_boost");
+            if (f.exists()) {
+                try {
+                    byte[] b = new byte[32];
+                    RandomAccessFile raf = new RandomAccessFile(f, "r");
+                    int n = raf.read(b);
+                    raf.close();
+                    if (n > 0) {
+                        String s = new String(b, 0, n).trim();
+                        sBoostFactor = Float.parseFloat(s);
+                    } else {
+                        sBoostFactor = 4.0f;
+                    }
+                } catch (Throwable t) {
+                    sBoostFactor = 4.0f;
+                }
+            } else {
+                sBoostFactor = 1.0f;
+            }
+        }
+        return sBoostFactor;
+    }
+
+    private static void processPhysicalMicBuffer(AudioRecord record, ByteBuffer audioBuffer, int sizeInBytes) {
+        try {
+            float boost = getBoostFactor();
+            long now = System.currentTimeMillis();
+            boolean needLog = (now - sLastRealMicLogTime > 2000);
+
+            int pos = audioBuffer.position();
+            int limit = audioBuffer.limit();
+            int samples = sizeInBytes / 2;
+            int maxAmp = 0;
+            long sumSquare = 0;
+
+            audioBuffer.position(pos);
+            ByteOrder origOrder = audioBuffer.order();
+            audioBuffer.order(ByteOrder.LITTLE_ENDIAN);
+
+            for (int i = 0; i < samples; i++) {
+                int sampleIdx = pos + i * 2;
+                if (sampleIdx + 1 >= audioBuffer.capacity()) break;
+                short s = audioBuffer.getShort(sampleIdx);
+                int abs = Math.abs((int) s);
+                if (abs > maxAmp) maxAmp = abs;
+                sumSquare += (long) s * s;
+
+                if (boost > 1.01f) {
+                    int boosted = (int) (s * boost);
+                    if (boosted > 32767) boosted = 32767;
+                    else if (boosted < -32768) boosted = -32768;
+                    audioBuffer.putShort(sampleIdx, (short) boosted);
+                }
+            }
+
+            audioBuffer.position(pos);
+            audioBuffer.limit(limit);
+            audioBuffer.order(origOrder);
+
+            if (needLog) {
+                sLastRealMicLogTime = now;
+                int rms = (int) Math.sqrt(sumSquare / Math.max(1, samples));
+                Log.i(TAG, "REAL_MIC: maxAmp=" + maxAmp + ", rms=" + rms + ", bytes=" + sizeInBytes + ", boost=" + boost);
+            }
+        } catch (Throwable t) {
+            // Ignore
+        }
+    }
+
+    private static void processPhysicalMicShorts(AudioRecord record, short[] audioData, int offset, int count) {
+        try {
+            float boost = getBoostFactor();
+            long now = System.currentTimeMillis();
+            boolean needLog = (now - sLastRealMicLogTime > 2000);
+
+            int maxAmp = 0;
+            long sumSquare = 0;
+
+            for (int i = 0; i < count; i++) {
+                int idx = offset + i;
+                short s = audioData[idx];
+                int abs = Math.abs((int) s);
+                if (abs > maxAmp) maxAmp = abs;
+                sumSquare += (long) s * s;
+
+                if (boost > 1.01f) {
+                    int boosted = (int) (s * boost);
+                    if (boosted > 32767) boosted = 32767;
+                    else if (boosted < -32768) boosted = -32768;
+                    audioData[idx] = (short) boosted;
+                }
+            }
+
+            if (needLog) {
+                sLastRealMicLogTime = now;
+                int rms = (int) Math.sqrt(sumSquare / Math.max(1, count));
+                Log.i(TAG, "REAL_MIC [shorts]: maxAmp=" + maxAmp + ", rms=" + rms + ", count=" + count + ", boost=" + boost);
+            }
+        } catch (Throwable t) {}
+    }
+
+    private static void processPhysicalMicBytes(AudioRecord record, byte[] audioData, int offset, int count) {
+        try {
+            float boost = getBoostFactor();
+            long now = System.currentTimeMillis();
+            boolean needLog = (now - sLastRealMicLogTime > 2000);
+
+            int samples = count / 2;
+            int maxAmp = 0;
+            long sumSquare = 0;
+
+            for (int i = 0; i < samples; i++) {
+                int idx = offset + i * 2;
+                if (idx + 1 >= audioData.length) break;
+                short s = (short) ((audioData[idx] & 0xFF) | (audioData[idx + 1] << 8));
+                int abs = Math.abs((int) s);
+                if (abs > maxAmp) maxAmp = abs;
+                sumSquare += (long) s * s;
+
+                if (boost > 1.01f) {
+                    int boosted = (int) (s * boost);
+                    if (boosted > 32767) boosted = 32767;
+                    else if (boosted < -32768) boosted = -32768;
+                    audioData[idx] = (byte) (boosted & 0xFF);
+                    audioData[idx + 1] = (byte) ((boosted >> 8) & 0xFF);
+                }
+            }
+
+            if (needLog) {
+                sLastRealMicLogTime = now;
+                int rms = (int) Math.sqrt(sumSquare / Math.max(1, samples));
+                Log.i(TAG, "REAL_MIC [bytes]: maxAmp=" + maxAmp + ", rms=" + rms + ", count=" + count + ", boost=" + boost);
+            }
+        } catch (Throwable t) {}
+    }
+
+    private static class AudioSession {
+        final RandomAccessFile raf;
+        final int sourceChannels;
+        final int sourceSampleRate;
+        final int dataOffset;
+        final long fileLength;
+        private long lastLogTime = 0;
+
+        AudioSession(RandomAccessFile raf, int channels, int sampleRate, int dataOffset, long fileLength) {
+            this.raf = raf;
+            this.sourceChannels = channels;
+            this.sourceSampleRate = sampleRate;
+            this.dataOffset = dataOffset;
+            this.fileLength = fileLength;
+        }
+
+        synchronized byte[] readRaw(int count) {
+            byte[] buf = new byte[count];
+            int total = 0;
+            try {
+                while (total < count) {
+                    int read = raf.read(buf, total, count - total);
+                    if (read < 0) {
+                        raf.seek(dataOffset);
+                        continue;
+                    }
+                    total += read;
+                }
+            } catch (Throwable t) {
+                Log.e(TAG, "readRaw error: " + t.getMessage());
+                return null;
+            }
+            return buf;
+        }
+
+        synchronized byte[] getSamples(int targetBytes, int targetChannels, String caller) {
+            long now = System.currentTimeMillis();
+            if (now - lastLogTime > 3000) {
+                lastLogTime = now;
+                Log.i(TAG, "Active virtual audio: caller=" + caller + ", bytes=" + targetBytes 
+                    + ", targetChannels=" + targetChannels + ", sourceChannels=" + sourceChannels);
+            }
+
+            if (targetChannels <= 0) targetChannels = 1;
+            int srcChan = (sourceChannels > 0) ? sourceChannels : 1;
+
+            if (targetChannels == srcChan) {
+                return readRaw(targetBytes);
+            } else if (srcChan == 1 && targetChannels == 2) {
+                // Mono source -> Stereo target (duplicate 16-bit mono to L/R)
+                int frames = targetBytes / 4;
+                int monoBytes = frames * 2;
+                byte[] mono = readRaw(monoBytes);
+                if (mono == null) return null;
+
+                byte[] stereo = new byte[targetBytes];
+                for (int i = 0; i < frames; i++) {
+                    byte b0 = mono[i * 2];
+                    byte b1 = mono[i * 2 + 1];
+                    stereo[i * 4] = b0;
+                    stereo[i * 4 + 1] = b1;
+                    stereo[i * 4 + 2] = b0;
+                    stereo[i * 4 + 3] = b1;
+                }
+                return stereo;
+            } else if (srcChan == 2 && targetChannels == 1) {
+                // Stereo source -> Mono target (take left channel)
+                int frames = targetBytes / 2;
+                int stereoBytes = frames * 4;
+                byte[] stereo = readRaw(stereoBytes);
+                if (stereo == null) return null;
+
+                byte[] mono = new byte[targetBytes];
+                for (int i = 0; i < frames; i++) {
+                    mono[i * 2] = stereo[i * 4];
+                    mono[i * 2 + 1] = stereo[i * 4 + 1];
+                }
+                return mono;
+            } else {
+                return readRaw(targetBytes);
+            }
+        }
+    }
+
+    private static final Map<AudioRecord, AudioSession> sSessions = new ConcurrentHashMap<>();
+
+    private static AudioSession getSession(AudioRecord record) {
+        if (new File(DISABLE_FLAG).exists()) {
+            return null;
+        }
+        File audioFile = null;
+        for (String path : AUDIO_PATHS) {
+            File f = new File(path);
+            if (f.exists() && f.length() > 44 && f.canRead()) {
+                audioFile = f;
+                break;
+            }
+        }
+        if (audioFile == null) {
+            return null;
+        }
+
+        AudioSession session = sSessions.get(record);
+        if (session == null) {
+            try {
+                RandomAccessFile raf = new RandomAccessFile(audioFile, "r");
+                int channels = 1;
+                int sampleRate = 48000;
+                int dataOffset = 0;
+
+                if (audioFile.getName().toLowerCase().endsWith(".wav")) {
+                    byte[] header = new byte[128];
+                    int readLen = raf.read(header);
+                    if (readLen >= 44 && header[0] == 'R' && header[1] == 'I' && header[2] == 'F' && header[3] == 'F') {
+                        channels = (header[22] & 0xFF) | ((header[23] & 0xFF) << 8);
+                        sampleRate = (header[24] & 0xFF) | ((header[25] & 0xFF) << 8) 
+                                   | ((header[26] & 0xFF) << 16) | ((header[27] & 0xFF) << 24);
+                        
+                        // Search for 'data' chunk
+                        dataOffset = 44;
+                        for (int i = 12; i < readLen - 4; i++) {
+                            if (header[i] == 'd' && header[i+1] == 'a' && header[i+2] == 't' && header[i+3] == 'a') {
+                                dataOffset = i + 8;
+                                break;
+                            }
+                        }
+                    }
+                    raf.seek(dataOffset);
+                } else {
+                    raf.seek(0);
+                }
+
+                session = new AudioSession(raf, channels, sampleRate, dataOffset, audioFile.length());
+                sSessions.put(record, session);
+                Log.i(TAG, "VCAM virtual audio opened: " + audioFile.getAbsolutePath() 
+                    + " (srcChannels=" + channels + ", srcRate=" + sampleRate + ", offset=" + dataOffset + ")");
+            } catch (Throwable t) {
+                Log.e(TAG, "Failed to open virtual audio: " + t.getMessage(), t);
+                return null;
+            }
+        }
+        return session;
+    }
+
+    public static void replaceBytes(AudioRecord record, byte[] audioData, int offsetInBytes, int sizeInBytes) {
+        if (record == null || audioData == null || sizeInBytes <= 0) return;
+        try {
+            AudioSession session = getSession(record);
+            if (session == null) {
+                processPhysicalMicBytes(record, audioData, offsetInBytes, sizeInBytes);
+                return;
+            }
+
+            int targetChannels = record.getChannelCount();
+            byte[] pcm = session.getSamples(sizeInBytes, targetChannels, "replaceBytes");
+            if (pcm == null) return;
+
+            System.arraycopy(pcm, 0, audioData, offsetInBytes, sizeInBytes);
+        } catch (Throwable t) {
+            Log.e(TAG, "replaceBytes error: " + t.getMessage(), t);
+        }
+    }
+
+    public static void replaceShorts(AudioRecord record, short[] audioData, int offsetInShorts, int sizeInShorts) {
+        if (record == null || audioData == null || sizeInShorts <= 0) return;
+        try {
+            AudioSession session = getSession(record);
+            if (session == null) {
+                processPhysicalMicShorts(record, audioData, offsetInShorts, sizeInShorts);
+                return;
+            }
+
+            int bytesNeeded = sizeInShorts * 2;
+            int targetChannels = record.getChannelCount();
+            byte[] pcm = session.getSamples(bytesNeeded, targetChannels, "replaceShorts");
+            if (pcm == null) return;
+
+            ByteBuffer.wrap(pcm).order(ByteOrder.LITTLE_ENDIAN).asShortBuffer().get(audioData, offsetInShorts, sizeInShorts);
+        } catch (Throwable t) {
+            Log.e(TAG, "replaceShorts error: " + t.getMessage(), t);
+        }
+    }
+
+    public static void replaceBuffer(AudioRecord record, ByteBuffer audioBuffer, int sizeInBytes) {
+        if (record == null || audioBuffer == null || sizeInBytes <= 0 || audioBuffer.isReadOnly()) return;
+        try {
+            AudioSession session = getSession(record);
+            if (session == null) {
+                processPhysicalMicBuffer(record, audioBuffer, sizeInBytes);
+                return;
+            }
+
+            int targetChannels = record.getChannelCount();
+            byte[] pcm = session.getSamples(sizeInBytes, targetChannels, "replaceBuffer");
+            if (pcm == null) return;
+
+            int curPos = audioBuffer.position();
+            int curLimit = audioBuffer.limit();
+            try {
+                audioBuffer.position(curPos);
+                if (audioBuffer.capacity() >= curPos + sizeInBytes) {
+                    audioBuffer.limit(Math.max(curLimit, curPos + sizeInBytes));
+                }
+                audioBuffer.put(pcm, 0, sizeInBytes);
+            } finally {
+                audioBuffer.position(curPos);
+                audioBuffer.limit(curLimit);
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "replaceBuffer error: " + t.getMessage(), t);
+        }
+    }
+
+    public static void onAudioRecordRelease(AudioRecord record) {
+        if (record == null) return;
+        AudioSession session = sSessions.remove(record);
+        if (session != null && session.raf != null) {
+            try {
+                session.raf.close();
+                Log.i(TAG, "AudioRecord released and session closed.");
+            } catch (Throwable ignored) {}
+        }
+    }
+}
