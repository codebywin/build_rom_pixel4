+                            EGL14.eglQuerySurface(mEGLDisplay, eglSurf, EGL14.EGL_HEIGHT, queryH, 0);
+                            if (queryW[0] > 0) w = queryW[0];
+                            if (queryH[0] > 0) h = queryH[0];
