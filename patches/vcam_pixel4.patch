+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+public class VcamAudioEngine {
+    private static final String TAG = "VCAM_AUDIO";
+    private static final String[] AUDIO_PATHS = new String[] {
+        "/data/local/tmp/vcam.wav",
+        "/data/local/tmp/vcam.pcm",
+        "/sdcard/vcam.wav",
+        "/sdcard/vcam.pcm"
+    };
+
+    private static long sLastRealMicLogTime = 0;
+    private static float sBoostFactor = 1.0f;
+    private static long sLastBoostCheckTime = 0;
+
+    private static boolean isFileFlagActive(String path) {
+        File f = new File(path);
+        if (!f.exists()) return false;
+        if (f.length() == 0) return true;
+        try {
+            RandomAccessFile raf = new RandomAccessFile(f, "r");
+            byte[] b = new byte[8];
+            int n = raf.read(b);
+            raf.close();
+            if (n > 0) {
+                String s = new String(b, 0, n).trim();
+                if ("0".equals(s)) return false;
+            }
+        } catch (Throwable ignored) {}
+        return true;
+    }
+
+    private static boolean isAudioDisabled() {
+        if (isFileFlagActive("/data/local/tmp/vcam_disable") || isFileFlagActive("/sdcard/vcam_disable")) {
+            return true;
+        }
+        if (isFileFlagActive("/data/local/tmp/vcam_mic_disable") || isFileFlagActive("/sdcard/vcam_mic_disable")) {
+            return true;
+        }
+        return false;
+    }
+
+    private static boolean isAudioMix() {
+        return isFileFlagActive("/data/local/tmp/vcam_mic_mix") || isFileFlagActive("/sdcard/vcam_mic_mix");
+    }
+
+    private static boolean isAudioPaused() {
+        return isFileFlagActive("/data/local/tmp/vcam_pause") || isFileFlagActive("/sdcard/vcam_pause");
+    }
+
+    private static volatile long sLastResetTimestamp = 0;
+    private static volatile long sLastResetCheckTime = 0;
+
+    private static void checkReset(AudioSession session) {
+        long now = System.currentTimeMillis();
+        if (now - sLastResetCheckTime > 150) {
+            sLastResetCheckTime = now;
+            long resetTs = readResetTimestamp();
+            if (resetTs > sLastResetTimestamp) {
+                sLastResetTimestamp = resetTs;
+                if (session != null) {
+                    try {
+                        synchronized (session) {
+                            session.raf.seek(session.dataOffset);
+                        }
+                        Log.i(TAG, "Virtual audio rewound to 00:00 (ts=" + resetTs + ")");
+                    } catch (Throwable t) {
+                        Log.w(TAG, "Virtual audio rewind error: " + t);
+                    }
+                }
+            }
+        }
+    }
+
+    private static long readResetTimestamp() {
+        for (String p : new String[]{"/data/local/tmp/vcam_reset", "/sdcard/vcam_reset"}) {
+            File f = new File(p);
+            if (f.exists() && f.length() > 0) {
+                try {
+                    RandomAccessFile raf = new RandomAccessFile(f, "r");
+                    byte[] b = new byte[32];
+                    int n = raf.read(b);
+                    raf.close();
+                    if (n > 0) {
+                        return Long.parseLong(new String(b, 0, n).trim());
+                    }
+                } catch (Throwable ignored) {}
+            }
+        }
+        return 0;
+    }
+
+    private static final String[] BOOST_PATHS = new String[] {
+        "/data/local/tmp/vcam_mic_boost",
+        "/sdcard/vcam_mic_boost",
+        "/storage/emulated/0/vcam_mic_boost"
+    };
+
+    private static float getBoostFactor() {
+        long now = System.currentTimeMillis();
+        if (now - sLastBoostCheckTime > 500) {
+            sLastBoostCheckTime = now;
+            File f = null;
+            for (String p : BOOST_PATHS) {
+                File test = new File(p);
+                if (test.exists() && test.length() > 0) {
+                    f = test;
+                    break;
+                }
+            }
+            if (f != null) {
+                try {
+                    byte[] b = new byte[32];
+                    RandomAccessFile raf = new RandomAccessFile(f, "r");
+                    int n = raf.read(b);
+                    raf.close();
+                    if (n > 0) {
+                        String s = new String(b, 0, n).trim();
+                        float val = Float.parseFloat(s);
+                        sBoostFactor = (val > 0.05f) ? val : 1.0f;
+                    } else {
+                        sBoostFactor = 3.0f;
+                    }
+                } catch (Throwable t) {
+                    sBoostFactor = 3.0f;
+                }
+            } else {
+                sBoostFactor = 1.0f;
+            }
+        }
+        return sBoostFactor;
+    }
+
+    private static void processPhysicalMicBuffer(AudioRecord record, ByteBuffer audioBuffer, int sizeInBytes, float boost) {
+        try {
+            int pos = audioBuffer.position();
+            int limit = audioBuffer.limit();
+            int samples = sizeInBytes / 2;
+
+            ByteOrder origOrder = audioBuffer.order();
+            audioBuffer.order(ByteOrder.LITTLE_ENDIAN);
+
+            for (int i = 0; i < samples; i++) {
+                int sampleIdx = pos + i * 2;
+                if (sampleIdx + 1 >= audioBuffer.capacity()) break;
+                short s = audioBuffer.getShort(sampleIdx);
+                int boosted = (int) (s * boost);
+                if (boosted > 32767) boosted = 32767;
+                else if (boosted < -32768) boosted = -32768;
+                audioBuffer.putShort(sampleIdx, (short) boosted);
+            }
+
+            audioBuffer.position(pos);
+            audioBuffer.limit(limit);
+            audioBuffer.order(origOrder);
+        } catch (Throwable t) {}
+    }
+
+    private static void processPhysicalMicShorts(AudioRecord record, short[] audioData, int offset, int count, float boost) {
+        try {
+            for (int i = 0; i < count; i++) {
+                int idx = offset + i;
+                short s = audioData[idx];
+                int boosted = (int) (s * boost);
+                if (boosted > 32767) boosted = 32767;
+                else if (boosted < -32768) boosted = -32768;
+                audioData[idx] = (short) boosted;
+            }
+        } catch (Throwable t) {}
+    }
+
+    private static void processPhysicalMicBytes(AudioRecord record, byte[] audioData, int offset, int count, float boost) {
+        try {
+            int samples = count / 2;
+            for (int i = 0; i < samples; i++) {
+                int idx = offset + i * 2;
+                if (idx + 1 >= audioData.length) break;
+                short s = (short) ((audioData[idx] & 0xFF) | (audioData[idx + 1] << 8));
+                int boosted = (int) (s * boost);
+                if (boosted > 32767) boosted = 32767;
+                else if (boosted < -32768) boosted = -32768;
+                audioData[idx] = (byte) (boosted & 0xFF);
+                audioData[idx + 1] = (byte) ((boosted >> 8) & 0xFF);
+            }
+        } catch (Throwable t) {}
+    }
+
+    private static class AudioSession {
+        final RandomAccessFile raf;
+        final int sourceChannels;
+        final int sourceSampleRate;
+        final int dataOffset;
+        final long fileLength;
+        private long lastLogTime = 0;
+
+        AudioSession(RandomAccessFile raf, int channels, int sampleRate, int dataOffset, long fileLength) {
+            this.raf = raf;
+            this.sourceChannels = channels;
+            this.sourceSampleRate = sampleRate;
+            this.dataOffset = dataOffset;
+            this.fileLength = fileLength;
+        }
+
+        synchronized byte[] readRaw(int count) {
+            byte[] buf = new byte[count];
+            int total = 0;
+            try {
+                while (total < count) {
+                    int read = raf.read(buf, total, count - total);
+                    if (read < 0) {
+                        raf.seek(dataOffset);
+                        continue;
+                    }
+                    total += read;
+                }
+            } catch (Throwable t) {
+                Log.e(TAG, "readRaw error: " + t.getMessage());
+                return null;
+            }
+            return buf;
+        }
+
+        synchronized byte[] getSamples(int targetBytes, int targetChannels, int targetSampleRate, String caller) {
+            checkReset(this);
+            long now = System.currentTimeMillis();
+            if (now - lastLogTime > 3000) {
+                lastLogTime = now;
+                Log.i(TAG, "Active virtual audio: caller=" + caller + ", bytes=" + targetBytes
+                    + ", targetCh=" + targetChannels + ", targetSR=" + targetSampleRate
+                    + ", srcCh=" + sourceChannels + ", srcSR=" + sourceSampleRate);
+            }
+
+            if (targetChannels <= 0) targetChannels = 1;
+            int srcChan = (sourceChannels > 0) ? sourceChannels : 1;
+            int srcRate = (sourceSampleRate > 0) ? sourceSampleRate : 44100;
+            int dstRate = (targetSampleRate > 0) ? targetSampleRate : srcRate;
+
+            // Target frames = targetBytes / (2 bytes * targetChannels)
+            int dstFrames = targetBytes / (2 * targetChannels);
+
+            // Source frames needed = dstFrames * (srcRate / dstRate)
+            int srcFrames = (int) ((long) dstFrames * srcRate / dstRate);
+            if (srcFrames < 1) srcFrames = 1;
+
+            // Read source bytes
+            int srcBytes = srcFrames * srcChan * 2;
+            byte[] srcBuf = readRaw(srcBytes);
+            if (srcBuf == null) return null;
+
+            // Build output with linear interpolation resampling
+            byte[] dst = new byte[dstFrames * targetChannels * 2];
+
+            for (int dstF = 0; dstF < dstFrames; dstF++) {
+                float srcPos = (float) dstF * srcRate / dstRate;
+                int s0 = (int) srcPos;
+                int s1 = s0 + 1;
+                float frac = srcPos - s0;
+                if (s1 >= srcFrames) s1 = srcFrames - 1;
+
+                for (int ch = 0; ch < targetChannels; ch++) {
+                    int srcCh = (ch < srcChan) ? ch : (srcChan - 1);
+                    int idx0 = (s0 * srcChan + srcCh) * 2;
+                    int idx1 = (s1 * srcChan + srcCh) * 2;
+
+                    short v0 = 0, v1 = 0;
+                    if (idx0 + 1 < srcBuf.length) {
+                        v0 = (short) ((srcBuf[idx0] & 0xFF) | (srcBuf[idx0 + 1] << 8));
+                    }
+                    if (idx1 + 1 < srcBuf.length) {
+                        v1 = (short) ((srcBuf[idx1] & 0xFF) | (srcBuf[idx1 + 1] << 8));
+                    }
+
+                    short out = (short) (v0 + (int) ((v1 - v0) * frac));
+                    int dstIdx = (dstF * targetChannels + ch) * 2;
+                    dst[dstIdx]     = (byte) (out & 0xFF);
+                    dst[dstIdx + 1] = (byte) ((out >> 8) & 0xFF);
+                }
+            }
+            return dst;
+        }
+    }
+
+    private static final Map<AudioRecord, AudioSession> sSessions = new ConcurrentHashMap<>();
+
+    private static AudioSession getSession(AudioRecord record) {
+        if (isAudioDisabled()) {
+            if (!sSessions.isEmpty()) {
+                for (AudioSession s : sSessions.values()) {
+                    try { s.raf.close(); } catch (Throwable ignored) {}
+                }
+                sSessions.clear();
+            }
+            return null;
+        }
+        File audioFile = null;
+        for (String path : AUDIO_PATHS) {
+            File f = new File(path);
+            if (f.exists() && f.length() > 44 && f.canRead()) {
+                audioFile = f;
+                break;
+            }
+        }
+        if (audioFile == null) {
+            return null;
+        }
+
+        AudioSession session = sSessions.get(record);
+        if (session == null) {
+            try {
+                RandomAccessFile raf = new RandomAccessFile(audioFile, "r");
+                int channels = 1;
+                int sampleRate = 48000;
+                int dataOffset = 0;
+
+                if (audioFile.getName().toLowerCase().endsWith(".wav")) {
+                    byte[] header = new byte[128];
+                    int readLen = raf.read(header);
+                    if (readLen >= 44 && header[0] == 'R' && header[1] == 'I' && header[2] == 'F' && header[3] == 'F') {
+                        channels = (header[22] & 0xFF) | ((header[23] & 0xFF) << 8);
+                        sampleRate = (header[24] & 0xFF) | ((header[25] & 0xFF) << 8) 
+                                   | ((header[26] & 0xFF) << 16) | ((header[27] & 0xFF) << 24);
+                        
+                        dataOffset = 44;
+                        for (int i = 12; i < readLen - 4; i++) {
+                            if (header[i] == 'd' && header[i+1] == 'a' && header[i+2] == 't' && header[i+3] == 'a') {
+                                dataOffset = i + 8;
+                                break;
+                            }
+                        }
+                    }
+                    raf.seek(dataOffset);
+                } else {
+                    raf.seek(0);
+                }
+
+                session = new AudioSession(raf, channels, sampleRate, dataOffset, audioFile.length());
+                sSessions.put(record, session);
+                Log.i(TAG, "VCAM virtual audio opened: " + audioFile.getAbsolutePath() 
+                    + " (srcChannels=" + channels + ", srcRate=" + sampleRate + ", offset=" + dataOffset + ")");
+            } catch (Throwable t) {
+                Log.e(TAG, "Failed to open virtual audio: " + t.getMessage(), t);
+                return null;
+            }
+        }
+        return session;
+    }
+
+    private static long sLastEntryLog = 0;
+    public static void replaceBytes(AudioRecord record, byte[] audioData, int offsetInBytes, int sizeInBytes) {
+        if (record == null || audioData == null || sizeInBytes <= 0) return;
+        try {
+            long now2 = System.currentTimeMillis();
+            if (now2 - sLastEntryLog > 3000) {
+                sLastEntryLog = now2;
+                Log.i(TAG, "replaceBytes called: sr=" + (record != null ? record.getSampleRate() : 0)
+                    + " ch=" + (record != null ? record.getChannelCount() : 0)
+                    + " fmt=" + (record != null ? record.getAudioFormat() : 0)
+                    + " bytes=" + sizeInBytes);
+            }
+            AudioSession session = getSession(record);
+            if (session == null) {
+                float boost = getBoostFactor();
+                if (boost > 1.01f) {
+                    processPhysicalMicBytes(record, audioData, offsetInBytes, sizeInBytes, boost);
+                    long nowLog = System.currentTimeMillis();
+                    if (nowLog - sLastRealMicLogTime > 5000) {
+                        sLastRealMicLogTime = nowLog;
+                        Log.i(TAG, "Boosted physical mic (bytes) by x" + boost);
+                    }
+                }
+                return;
+            }
+
+            if (isAudioPaused()) {
+                if (isAudioMix()) {
+                    float boost = getBoostFactor();
+                    if (boost > 1.01f) {
+                        processPhysicalMicBytes(record, audioData, offsetInBytes, sizeInBytes, boost);
+                    }
+                } else {
+                    java.util.Arrays.fill(audioData, offsetInBytes, offsetInBytes + sizeInBytes, (byte) 0);
+                }
+                return;
+            }
+
+            int targetChannels = record.getChannelCount();
+            int targetSampleRate = record.getSampleRate();
+            byte[] pcm = session.getSamples(sizeInBytes, targetChannels, targetSampleRate, "replaceBytes");
+            if (pcm == null) return;
+
+            // Kiểm tra nếu bật chế độ Trộn âm thanh (vcam_mic_mix)
+            if (isAudioMix()) {
+                float boost = getBoostFactor();
+                int samples = sizeInBytes / 2;
+                for (int i = 0; i < samples; i++) {
+                    int idx = offsetInBytes + i * 2;
+                    if (idx + 1 >= audioData.length || i * 2 + 1 >= pcm.length) break;
+                    short mic = (short) ((audioData[idx] & 0xFF) | (audioData[idx + 1] << 8));
+                    short wav = (short) ((pcm[i * 2] & 0xFF) | (pcm[i * 2 + 1] << 8));
+                    int micVal = (boost > 1.01f) ? (int) (mic * boost) : mic;
+                    int mixed = micVal + wav;
+                    if (mixed > 32767) mixed = 32767;
+                    else if (mixed < -32768) mixed = -32768;
+                    audioData[idx] = (byte) (mixed & 0xFF);
+                    audioData[idx + 1] = (byte) ((mixed >> 8) & 0xFF);
+                }
+            } else {
+                // 100% âm thanh ảo sạch từ file WAV
+                System.arraycopy(pcm, 0, audioData, offsetInBytes, sizeInBytes);
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "replaceBytes error: " + t.getMessage(), t);
+        }
+    }
+
+    public static void replaceShorts(AudioRecord record, short[] audioData, int offsetInShorts, int sizeInShorts) {
+        if (record == null || audioData == null || sizeInShorts <= 0) return;
+        try {
+            AudioSession session = getSession(record);
+            if (session == null) {
+                float boost = getBoostFactor();
+                if (boost > 1.01f) {
+                    processPhysicalMicShorts(record, audioData, offsetInShorts, sizeInShorts, boost);
+                    long nowLog = System.currentTimeMillis();
+                    if (nowLog - sLastRealMicLogTime > 5000) {
+                        sLastRealMicLogTime = nowLog;
+                        Log.i(TAG, "Boosted physical mic (shorts) by x" + boost);
+                    }
+                }
+                return;
+            }
+
+            if (isAudioPaused()) {
+                if (isAudioMix()) {
+                    float boost = getBoostFactor();
+                    if (boost > 1.01f) {
+                        processPhysicalMicShorts(record, audioData, offsetInShorts, sizeInShorts, boost);
+                    }
+                } else {
+                    java.util.Arrays.fill(audioData, offsetInShorts, offsetInShorts + sizeInShorts, (short) 0);
+                }
+                return;
+            }
+
+            int bytesNeeded = sizeInShorts * 2;
+            int targetChannels = record.getChannelCount();
+            int targetSampleRate = record.getSampleRate();
+            byte[] pcm = session.getSamples(bytesNeeded, targetChannels, targetSampleRate, "replaceShorts");
+            if (pcm == null) return;
+
+            if (isAudioMix()) {
+                float boost = getBoostFactor();
+                ShortBuffer sb = ByteBuffer.wrap(pcm).order(ByteOrder.LITTLE_ENDIAN).asShortBuffer();
+                for (int i = 0; i < sizeInShorts; i++) {
+                    if (!sb.hasRemaining()) break;
+                    short mic = audioData[offsetInShorts + i];
+                    short wav = sb.get();
+                    int micVal = (boost > 1.01f) ? (int) (mic * boost) : mic;
+                    int mixed = micVal + wav;
+                    if (mixed > 32767) mixed = 32767;
+                    else if (mixed < -32768) mixed = -32768;
+                    audioData[offsetInShorts + i] = (short) mixed;
+                }
+            } else {
+                ByteBuffer.wrap(pcm).order(ByteOrder.LITTLE_ENDIAN).asShortBuffer().get(audioData, offsetInShorts, sizeInShorts);
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "replaceShorts error: " + t.getMessage(), t);
+        }
+    }
+
+    public static void replaceBuffer(AudioRecord record, ByteBuffer audioBuffer, int sizeInBytes) {
+        if (record == null || audioBuffer == null || sizeInBytes <= 0 || audioBuffer.isReadOnly()) return;
+        try {
+            AudioSession session = getSession(record);
+            if (session == null) {
+                float boost = getBoostFactor();
+                if (boost > 1.01f) {
+                    processPhysicalMicBuffer(record, audioBuffer, sizeInBytes, boost);
+                    long nowLog = System.currentTimeMillis();
+                    if (nowLog - sLastRealMicLogTime > 5000) {
+                        sLastRealMicLogTime = nowLog;
+                        Log.i(TAG, "Boosted physical mic (buffer) by x" + boost);
+                    }
+                }
+                return;
+            }
+
+            if (isAudioPaused()) {
+                if (isAudioMix()) {
+                    float boost = getBoostFactor();
+                    if (boost > 1.01f) {
+                        processPhysicalMicBuffer(record, audioBuffer, sizeInBytes, boost);
+                    }
+                } else {
+                    int curPos = audioBuffer.position();
+                    int curLimit = audioBuffer.limit();
+                    try {
+                        audioBuffer.position(curPos);
+                        int end = Math.min(audioBuffer.capacity(), curPos + sizeInBytes);
+                        for (int i = curPos; i < end; i++) {
+                            audioBuffer.put(i, (byte) 0);
+                        }
+                    } finally {
+                        audioBuffer.position(curPos);
+                        audioBuffer.limit(curLimit);
+                    }
+                }
+                return;
+            }
+
+            int targetChannels = record.getChannelCount();
+            int targetSampleRate = record.getSampleRate();
+            byte[] pcm = session.getSamples(sizeInBytes, targetChannels, targetSampleRate, "replaceBuffer");
+            if (pcm == null) return;
+
+            if (isAudioMix()) {
+                float boost = getBoostFactor();
+                int curPos = audioBuffer.position();
+                int curLimit = audioBuffer.limit();
+                ByteOrder origOrder = audioBuffer.order();
+                audioBuffer.order(ByteOrder.LITTLE_ENDIAN);
+                try {
+                    int samples = sizeInBytes / 2;
+                    for (int i = 0; i < samples; i++) {
+                        int sampleIdx = curPos + i * 2;
+                        if (sampleIdx + 1 >= audioBuffer.capacity() || i * 2 + 1 >= pcm.length) break;
+                        short mic = audioBuffer.getShort(sampleIdx);
+                        short wav = (short) ((pcm[i * 2] & 0xFF) | (pcm[i * 2 + 1] << 8));
+                        int micVal = (boost > 1.01f) ? (int) (mic * boost) : mic;
+                        int mixed = micVal + wav;
+                        if (mixed > 32767) mixed = 32767;
+                        else if (mixed < -32768) mixed = -32768;
+                        audioBuffer.putShort(sampleIdx, (short) mixed);
+                    }
+                } finally {
+                    audioBuffer.position(curPos);
+                    audioBuffer.limit(curLimit);
+                    audioBuffer.order(origOrder);
+                }
+            } else {
+                int curPos = audioBuffer.position();
+                int curLimit = audioBuffer.limit();
+                try {
+                    audioBuffer.position(curPos);
+                    if (audioBuffer.capacity() >= curPos + sizeInBytes) {
+                        audioBuffer.limit(Math.max(curLimit, curPos + sizeInBytes));
+                    }
+                    audioBuffer.put(pcm, 0, sizeInBytes);
+                } finally {
+                    audioBuffer.position(curPos);
+                    audioBuffer.limit(curLimit);
+                }
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "replaceBuffer error: " + t.getMessage(), t);
+        }
+    }
+
+    public static void onAudioRecordRelease(AudioRecord record) {
+        if (record == null) return;
+        AudioSession session = sSessions.remove(record);
+        if (session != null && session.raf != null) {
+            try {
+                session.raf.close();
+                Log.i(TAG, "AudioRecord released and session closed.");
+            } catch (Throwable ignored) {}
+        }
+    }
