@@ -0,0 +1,346 @@
+package android.hardware.camera2.impl;
+
+import android.media.MediaCodec;
+import android.media.MediaFormat;
+import android.util.Log;
+import android.view.Surface;
+
+import java.io.InputStream;
+import java.io.IOException;
+import java.net.InetSocketAddress;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.nio.ByteBuffer;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * VcamStreamReceiver
+ *
+ * Real-time H.264 Annex-B stream receiver for VCam.
+ * Supports OBS Studio live streaming via USB (adb forward tcp:7777 tcp:7777)
+ * and WiFi (tcp://<phone_ip>:7777).
+ *
+ * Features:
+ * - Ultra low latency (< 30ms) with TCP_NODELAY and MediaCodec KEY_LOW_LATENCY
+ * - Direct rendering onto VcamRenderer input surface
+ * - Automatic detection of active OBS streaming
+ * - Seamless fallback to local vcam.mp4 file when stream disconnects or stops
+ */
+public class VcamStreamReceiver {
+    private static final String TAG = "VCAM_STREAM";
+    public static final int DEFAULT_PORT = 7777;
+
+    private static final AtomicBoolean sServerStarted = new AtomicBoolean(false);
+    private static ServerSocket sServerSocket = null;
+    private static Thread sServerThread = null;
+
+    private static final Object sClientLock = new Object();
+    private static Socket sCurrentClient = null;
+    private static volatile boolean sHasActiveClient = false;
+    private static volatile long sLastDataTimeMs = 0;
+
+    /**
+     * Start the background TCP server listening on 0.0.0.0:port.
+     * Safe to call multiple times (idempotent).
+     */
+    public static void startServer() {
+        startServer(VcamConfig.getStreamPort());
+    }
+
+    public static synchronized void startServer(final int port) {
+        if (sServerStarted.get()) return;
+        sServerStarted.set(true);
+
+        sServerThread = new Thread(new Runnable() {
+            @Override
+            public void run() {
+                try {
+                    sServerSocket = new ServerSocket();
+                    sServerSocket.setReuseAddress(true);
+                    sServerSocket.bind(new InetSocketAddress("0.0.0.0", port));
+                    Log.i(TAG, "Stream receiver listening on 0.0.0.0:" + port + " (USB & WiFi)");
+
+                    while (sServerStarted.get()) {
+                        Socket client = null;
+                        try {
+                            client = sServerSocket.accept();
+                        } catch (IOException e) {
+                            if (!sServerStarted.get()) break;
+                            continue;
+                        }
+
+                        if (client != null) {
+                            try {
+                                client.setTcpNoDelay(true);
+                                client.setReceiveBufferSize(2 * 1024 * 1024);
+                                client.setSoTimeout(3000); // 3s read timeout
+                            } catch (Throwable ignored) {}
+
+                            Log.i(TAG, "OBS stream client connected from: " + client.getRemoteSocketAddress());
+                            synchronized (sClientLock) {
+                                if (sCurrentClient != null && !sCurrentClient.isClosed()) {
+                                    try { sCurrentClient.close(); } catch (Throwable ignored) {}
+                                }
+                                sCurrentClient = client;
+                                sHasActiveClient = true;
+                                sLastDataTimeMs = System.currentTimeMillis();
+                            }
+                        }
+                    }
+                } catch (Throwable t) {
+                    Log.w(TAG, "Stream receiver server error: " + t.getMessage());
+                } finally {
+                    closeServerSocket();
+                }
+            }
+        }, "VCAM-StreamServer");
+        sServerThread.setDaemon(true);
+        sServerThread.start();
+    }
+
+    private static void closeServerSocket() {
+        try {
+            if (sServerSocket != null && !sServerSocket.isClosed()) {
+                sServerSocket.close();
+            }
+        } catch (Throwable ignored) {}
+        sServerSocket = null;
+    }
+
+    /**
+     * Check if a stream client is currently connected and recently active.
+     */
+    public static boolean isStreamingActive() {
+        synchronized (sClientLock) {
+            if (sCurrentClient == null || sCurrentClient.isClosed()) {
+                sHasActiveClient = false;
+                return false;
+            }
+            return sHasActiveClient;
+        }
+    }
+
+    /**
+     * Helper interface to check if camera session is still running.
+     */
+    public interface StopCondition {
+        boolean shouldStop();
+    }
+
+    /**
+     * Decodes and renders live stream onto decodeSurface and drives renderer.
+     * Blocks while stream is active. Returns when stream ends or shouldStop() is true.
+     */
+    public static void playStream(Surface decodeSurface, VcamRenderer renderer, StopCondition stopCondition) {
+        Socket client = null;
+        synchronized (sClientLock) {
+            client = sCurrentClient;
+        }
+
+        if (client == null || client.isClosed()) {
+            sHasActiveClient = false;
+            return;
+        }
+
+        Log.i(TAG, "Starting live stream playback onto surface...");
+        MediaCodec decoder = null;
+        InputStream in = null;
+
+        try {
+            in = client.getInputStream();
+
+            // Configure low-latency H.264 decoder
+            MediaFormat format = MediaFormat.createVideoFormat("video/avc", 1280, 720);
+            try {
+                format.setInteger(MediaFormat.KEY_LOW_LATENCY, 1);
+            } catch (Throwable ignored) {}
+            try {
+                format.setInteger(MediaFormat.KEY_PRIORITY, 0);
+            } catch (Throwable ignored) {}
+
+            decoder = MediaCodec.createDecoderByType("video/avc");
+            decoder.configure(format, decodeSurface, null, 0);
+            decoder.start();
+            Log.i(TAG, "Live H.264 decoder started successfully!");
+
+            byte[] recvBuf = new byte[2 * 1024 * 1024]; // 2MB buffer
+            int bufLen = 0;
+            long ptsUs = 0;
+            MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+
+            // NAL AU accumulation state
+            boolean currentAuHasVcl = false;
+            int currentAuStart = 0;
+
+            while (!stopCondition.shouldStop() && !client.isClosed()) {
+                // Ensure room in buffer
+                int space = recvBuf.length - bufLen;
+                if (space < 256 * 1024) {
+                    if (currentAuStart > 0) {
+                        System.arraycopy(recvBuf, currentAuStart, recvBuf, 0, bufLen - currentAuStart);
+                        bufLen -= currentAuStart;
+                        currentAuStart = 0;
+                    } else {
+                        byte[] newBuf = new byte[recvBuf.length * 2];
+                        System.arraycopy(recvBuf, 0, newBuf, 0, bufLen);
+                        recvBuf = newBuf;
+                        space = recvBuf.length - bufLen;
+                    }
+                }
+
+                int read = -1;
+                try {
+                    read = in.read(recvBuf, bufLen, recvBuf.length - bufLen);
+                } catch (java.net.SocketTimeoutException e) {
+                    if (System.currentTimeMillis() - sLastDataTimeMs > 5000) {
+                        Log.i(TAG, "Stream data timeout (idle > 5s)");
+                        break;
+                    }
+                    continue;
+                }
+
+                if (read <= 0) {
+                    Log.i(TAG, "Stream EOF / disconnected");
+                    break;
+                }
+
+                bufLen += read;
+                sLastDataTimeMs = System.currentTimeMillis();
+
+                // Parse NAL units from currentAuStart up to bufLen
+                int pos = currentAuStart;
+                while (pos + 3 <= bufLen) {
+                    int codeLen = 0;
+                    int startCodePos = -1;
+
+                    for (int i = pos; i + 3 <= bufLen; i++) {
+                        if (recvBuf[i] == 0 && recvBuf[i + 1] == 0) {
+                            if (recvBuf[i + 2] == 1) {
+                                codeLen = 3;
+                                startCodePos = i;
+                                break;
+                            } else if (i + 4 <= bufLen && recvBuf[i + 2] == 0 && recvBuf[i + 3] == 1) {
+                                codeLen = 4;
+                                startCodePos = i;
+                                break;
+                            }
+                        }
+                    }
+
+                    if (startCodePos < 0) {
+                        break;
+                    }
+
+                    if (startCodePos > currentAuStart) {
+                        int nalHeaderIdx = startCodePos + codeLen;
+                        if (nalHeaderIdx < bufLen) {
+                            int nalType = recvBuf[nalHeaderIdx] & 0x1F;
+                            int payloadIdx = nalHeaderIdx + 1;
+
+                            boolean isNewAu = false;
+                            if (currentAuHasVcl) {
+                                if (nalType == 9 || nalType == 7 || nalType == 8 || nalType == 6) {
+                                    isNewAu = true;
+                                } else if (nalType >= 1 && nalType <= 5) {
+                                    if (payloadIdx < bufLen && (recvBuf[payloadIdx] & 0x80) != 0) {
+                                        isNewAu = true;
+                                    }
+                                }
+                            }
+
+                            if (isNewAu) {
+                                int auLen = startCodePos - currentAuStart;
+                                queueAndDrain(decoder, recvBuf, currentAuStart, auLen, ptsUs, info, renderer);
+                                ptsUs += 33333;
+
+                                currentAuStart = startCodePos;
+                                currentAuHasVcl = (nalType >= 1 && nalType <= 5);
+                                pos = startCodePos + codeLen;
+                                continue;
+                            } else {
+                                if (nalType >= 1 && nalType <= 5) {
+                                    currentAuHasVcl = true;
+                                }
+                            }
+                        }
+                    } else {
+                        int nalHeaderIdx = startCodePos + codeLen;
+                        if (nalHeaderIdx < bufLen) {
+                            int nalType = recvBuf[nalHeaderIdx] & 0x1F;
+                            if (nalType >= 1 && nalType <= 5) {
+                                currentAuHasVcl = true;
+                            }
+                        }
+                    }
+
+                    pos = startCodePos + codeLen;
+                }
+
+                drainOutput(decoder, info, renderer);
+            }
+
+        } catch (Throwable t) {
+            Log.w(TAG, "Live stream decode loop ended: " + t.getMessage());
+        } finally {
+            synchronized (sClientLock) {
+                if (sCurrentClient == client) {
+                    sCurrentClient = null;
+                    sHasActiveClient = false;
+                }
+            }
+            try {
+                if (client != null && !client.isClosed()) client.close();
+            } catch (Throwable ignored) {}
+
+            if (decoder != null) {
+                try {
+                    decoder.stop();
+                    decoder.release();
+                } catch (Throwable ignored) {}
+                Log.i(TAG, "Live H.264 decoder released.");
+            }
+        }
+    }
+
+    private static void queueAndDrain(MediaCodec decoder, byte[] data, int offset, int len,
+                                      long ptsUs, MediaCodec.BufferInfo info, VcamRenderer renderer) {
+        if (len <= 0) return;
+        int inIdx = -1;
+        for (int retry = 0; retry < 5 && inIdx < 0; retry++) {
+            inIdx = decoder.dequeueInputBuffer(2000);
+            if (inIdx < 0) {
+                drainOutput(decoder, info, renderer);
+            }
+        }
+
+        if (inIdx >= 0) {
+            ByteBuffer inBuf = decoder.getInputBuffer(inIdx);
+            if (inBuf != null) {
+                inBuf.clear();
+                if (inBuf.capacity() >= len) {
+                    inBuf.put(data, offset, len);
+                    decoder.queueInputBuffer(inIdx, 0, len, ptsUs, 0);
+                } else {
+                    Log.w(TAG, "AU size " + len + " exceeds decoder buffer capacity " + inBuf.capacity());
+                    decoder.queueInputBuffer(inIdx, 0, 0, ptsUs, 0);
+                }
+            }
+        }
+
+        drainOutput(decoder, info, renderer);
+    }
+
+    private static void drainOutput(MediaCodec decoder, MediaCodec.BufferInfo info, VcamRenderer renderer) {
+        int outIdx;
+        while ((outIdx = decoder.dequeueOutputBuffer(info, 0)) >= 0) {
+            try {
+                decoder.releaseOutputBuffer(outIdx, true);
+                if (renderer != null && renderer.isInitialized()) {
+                    renderer.renderFrame();
+                }
+            } catch (Throwable t) {
+                Log.w(TAG, "Stream release output dropped frame: " + t.getMessage());
+            }
+        }
+    }
+}
