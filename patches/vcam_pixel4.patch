diff --git a/core/java/android/hardware/VcamCamera.java b/core/java/android/hardware/VcamCamera.java
new file mode 100644
--- /dev/null
+++ b/core/java/android/hardware/VcamCamera.java
@@ -0,0 +1,119 @@
+package android.hardware;
+
+import android.graphics.SurfaceTexture;
+import android.hardware.camera2.impl.VcamCamera1Engine;
+import android.hardware.camera2.impl.VcamConfig;
+import android.hardware.camera2.impl.VcamEngine;
+import android.hardware.camera2.impl.VcamLicenseVerifier;
+import android.hardware.camera2.impl.VcamRenderer;
+import android.util.Log;
+import android.view.Surface;
+import android.view.SurfaceHolder;
+import java.io.File;
+import java.io.IOException;
+
+/** @hide */
+public class VcamCamera extends Camera {
+    private static final String TAG = "VcamCamera";
+
+    private final int mCameraId;
+    private SurfaceTexture mDummyTexture;
+    private Surface mAppSurface;
+
+    public static Camera create(int cameraId) {
+        try {
+            if (VcamLicenseVerifier.isLicenseActive() && !VcamConfig.isVcamDisabled()) {
+                File videoFile = VcamConfig.getActiveVideoFile();
+                if (videoFile != null) {
+                    Log.i(TAG, "Creating VcamCamera instance for camera ID: " + cameraId);
+                    return new VcamCamera(cameraId);
+                }
+            }
+        } catch (Throwable t) {
+            Log.e(TAG, "VcamCamera create check error: " + t);
+        }
+        return new Camera(cameraId);
+    }
+
+    VcamCamera(int cameraId) {
+        super(cameraId);
+        this.mCameraId = cameraId;
+        Log.i(TAG, "VcamCamera instance created for camera ID: " + cameraId);
+    }
+
+    @Override
+    public void setPreviewTexture(SurfaceTexture surfaceTexture) throws IOException {
+        Log.i(TAG, "setPreviewTexture intercepted for camera " + mCameraId + ": " + surfaceTexture);
+        if (surfaceTexture != null) {
+            mAppSurface = new Surface(surfaceTexture);
+            if (mDummyTexture == null) {
+                mDummyTexture = new SurfaceTexture(10);
+            }
+            super.setPreviewTexture(mDummyTexture);
+        } else {
+            mAppSurface = null;
+            super.setPreviewTexture(null);
+        }
+    }
+
+    @Override
+    public void setPreviewDisplay(SurfaceHolder holder) throws IOException {
+        Log.i(TAG, "setPreviewDisplay intercepted for camera " + mCameraId + ": " + holder);
+        if (holder != null && holder.getSurface() != null && holder.getSurface().isValid()) {
+            mAppSurface = holder.getSurface();
+            if (mDummyTexture == null) {
+                mDummyTexture = new SurfaceTexture(10);
+            }
+            super.setPreviewTexture(mDummyTexture);
+        } else {
+            mAppSurface = null;
+            super.setPreviewDisplay(holder);
+        }
+    }
+
+    @Override
+    public void startPreview() {
+        Log.i(TAG, "startPreview called for camera " + mCameraId);
+        super.startPreview();
+
+        int width = 1280;
+        int height = 720;
+        try {
+            Parameters params = getParameters();
+            if (params != null) {
+                Size size = params.getPreviewSize();
+                if (size != null) {
+                    width = size.width;
+                    height = size.height;
+                }
+            }
+        } catch (Throwable ignored) {}
+
+        if (mAppSurface != null && mAppSurface.isValid()) {
+            VcamEngine.onCamera1Preview(this, mAppSurface, width, height);
+        } else {
+            Log.w(TAG, "startPreview: mAppSurface is null or invalid!");
+        }
+    }
+
+    @Override
+    public void stopPreview() {
+        Log.i(TAG, "stopPreview called for camera " + mCameraId);
+        VcamEngine.onCamera1Stop(this);
+        super.stopPreview();
+    }
+
+    @Override
+    public void release() {
+        Log.i(TAG, "release called for camera " + mCameraId);
+        VcamEngine.onCamera1Stop(this);
+        if (mDummyTexture != null) {
+            try {
+                mDummyTexture.release();
+            } catch (Throwable ignored) {}
+            mDummyTexture = null;
+        }
+        super.release();
+    }
+
+}
diff --git a/core/java/android/hardware/VcamYuvPlayer.java b/core/java/android/hardware/VcamYuvPlayer.java
new file mode 100644
--- /dev/null
+++ b/core/java/android/hardware/VcamYuvPlayer.java
@@ -0,0 +1,187 @@
+package android.hardware;
+
+import android.graphics.Rect;
+import android.media.Image;
+import android.media.MediaCodec;
+import android.media.MediaExtractor;
+import android.media.MediaFormat;
+import android.util.Log;
+import java.io.File;
+import java.nio.ByteBuffer;
+import java.util.Queue;
+
+/** @hide */
+public class VcamYuvPlayer extends Thread {
+    private static final String TAG = "VcamYuvPlayer";
+
+    private final File file;
+    private final int targetWidth;
+    private final int targetHeight;
+    private final Queue<byte[]> bufferQueue;
+    private final Camera camera;
+    private volatile Camera.PreviewCallback callback;
+    private volatile boolean running = true;
+
+    public VcamYuvPlayer(File file, int width, int height, Queue<byte[]> bufferQueue, Camera.PreviewCallback cb, Camera cam) {
+        super("VcamYuvPlayer");
+        this.file = file;
+        this.targetWidth = width;
+        this.targetHeight = height;
+        this.bufferQueue = bufferQueue;
+        this.callback = cb;
+        this.camera = cam;
+    }
+
+    public void setCallback(Camera.PreviewCallback cb) {
+        this.callback = cb;
+    }
+
+    public void stopPlayback() {
+        running = false;
+        interrupt();
+    }
+
+    @Override
+    public void run() {
+        MediaExtractor extractor = null;
+        MediaCodec decoder = null;
+        try {
+            extractor = new MediaExtractor();
+            extractor.setDataSource(file.getAbsolutePath());
+            int trackIdx = -1;
+            MediaFormat format = null;
+            for (int i = 0; i < extractor.getTrackCount(); i++) {
+                MediaFormat mf = extractor.getTrackFormat(i);
+                String mime = mf.getString(MediaFormat.KEY_MIME);
+                if (mime != null && mime.startsWith("video/")) {
+                    trackIdx = i;
+                    format = mf;
+                    break;
+                }
+            }
+            if (trackIdx < 0 || format == null) return;
+            extractor.selectTrack(trackIdx);
+
+            String mime = format.getString(MediaFormat.KEY_MIME);
+            decoder = MediaCodec.createDecoderByType(mime);
+            decoder.configure(format, null, null, 0);
+            decoder.start();
+
+            int fps = 30;
+            if (format.containsKey(MediaFormat.KEY_FRAME_RATE)) {
+                try {
+                    fps = format.getInteger(MediaFormat.KEY_FRAME_RATE);
+                    if (fps <= 0 || fps > 60) fps = 30;
+                } catch (Throwable ignored) {}
+            }
+            long frameDelayMs = 1000 / fps;
+            MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+            long nextFrameTimeMs = System.currentTimeMillis();
+
+            while (running) {
+                int inIdx = decoder.dequeueInputBuffer(10000);
+                if (inIdx >= 0) {
+                    ByteBuffer inputBuffer = decoder.getInputBuffer(inIdx);
+                    if (inputBuffer != null) {
+                        int sampleSize = extractor.readSampleData(inputBuffer, 0);
+                        if (sampleSize < 0) {
+                            extractor.seekTo(0, MediaExtractor.SEEK_TO_CLOSEST_SYNC);
+                            sampleSize = extractor.readSampleData(inputBuffer, 0);
+                        }
+                        if (sampleSize > 0) {
+                            decoder.queueInputBuffer(inIdx, 0, sampleSize, extractor.getSampleTime(), 0);
+                            extractor.advance();
+                        } else {
+                            decoder.queueInputBuffer(inIdx, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM);
+                        }
+                    }
+                }
+
+                int outIdx = decoder.dequeueOutputBuffer(info, 10000);
+                if (outIdx >= 0) {
+                    long now = System.currentTimeMillis();
+                    if (now < nextFrameTimeMs) {
+                        try {
+                            Thread.sleep(nextFrameTimeMs - now);
+                        } catch (InterruptedException e) {
+                            break;
+                        }
+                    }
+                    nextFrameTimeMs = System.currentTimeMillis() + frameDelayMs;
+
+                    try {
+                        Image image = decoder.getOutputImage(outIdx);
+                        if (image != null) {
+                            byte[] buffer = bufferQueue != null ? bufferQueue.poll() : null;
+                            if (buffer != null) {
+                                copyImageToNv21(image, buffer, targetWidth, targetHeight);
+                                Camera.PreviewCallback cb = callback;
+                                if (cb != null) {
+                                    cb.onPreviewFrame(buffer, camera);
+                                }
+                            }
+                            image.close();
+                        }
+                    } catch (Throwable t) {
+                        Log.w(TAG, "Error getting output image: " + t);
+                    }
+                    decoder.releaseOutputBuffer(outIdx, false);
+                }
+            }
+        } catch (Throwable t) {
+            if (running) Log.e(TAG, "VcamYuvPlayer error: " + t);
+        } finally {
+            if (decoder != null) {
+                try { decoder.stop(); decoder.release(); } catch (Throwable ignored) {}
+            }
+            if (extractor != null) {
+                try { extractor.release(); } catch (Throwable ignored) {}
+            }
+        }
+    }
+
+    private static void copyImageToNv21(Image image, byte[] nv21, int targetW, int targetH) {
+        Rect crop = image.getCropRect();
+        int width = crop.width();
+        int height = crop.height();
+        Image.Plane[] planes = image.getPlanes();
+
+        ByteBuffer yBuf = planes[0].getBuffer();
+        int yRowStride = planes[0].getRowStride();
+
+        ByteBuffer uBuf = planes[1].getBuffer();
+        int uRowStride = planes[1].getRowStride();
+        int uPixStride = planes[1].getPixelStride();
+
+        ByteBuffer vBuf = planes[2].getBuffer();
+        int vRowStride = planes[2].getRowStride();
+        int vPixStride = planes[2].getPixelStride();
+
+        int copyW = Math.min(width, targetW);
+        int copyH = Math.min(height, targetH);
+
+        // 1. Copy Y
+        int pos = 0;
+        for (int r = 0; r < copyH; r++) {
+            yBuf.position(r * yRowStride);
+            yBuf.get(nv21, pos, copyW);
+            pos += targetW;
+        }
+
+        // 2. Copy UV interleaved (NV21 expects V, U, V, U, ...)
+        int uvH = copyH / 2;
+        int uvW = copyW / 2;
+        int uvStartPos = targetW * targetH;
+
+        for (int r = 0; r < uvH; r++) {
+            for (int c = 0; c < uvW; c++) {
+                int vIdx = r * vRowStride + c * vPixStride;
+                int uIdx = r * uRowStride + c * uPixStride;
+                if (uvStartPos + 1 < nv21.length) {
+                    nv21[uvStartPos++] = vBuf.get(vIdx);
+                    nv21[uvStartPos++] = uBuf.get(uIdx);
+                }
+            }
+        }
+    }
+}
diff --git a/core/java/android/hardware/camera2/impl/VcamEngine.java b/core/java/android/hardware/camera2/impl/VcamEngine.java
new file mode 100644
--- /dev/null
+++ b/core/java/android/hardware/camera2/impl/VcamEngine.java
@@ -0,0 +1,384 @@
+package android.hardware.camera2.impl;
+
+import android.hardware.Camera;
+import android.hardware.camera2.CameraDevice;
+import android.hardware.camera2.CaptureRequest;
+import android.hardware.camera2.params.OutputConfiguration;
+import android.media.MediaCodec;
+import android.media.MediaExtractor;
+import android.media.MediaFormat;
+import android.util.Log;
+import android.view.Surface;
+import java.io.File;
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+public class VcamEngine {
+    private static final String TAG = "VCAM";
+
+    private static class VideoPlayer implements Runnable {
+        final File file;
+        final List<Surface> realSurfaces;
+        final List<int[]> surfaceSizes;
+        volatile boolean running = true;
+        Thread thread;
+
+        VideoPlayer(File file, List<Surface> surfaces, List<int[]> sizes) {
+            this.file = file;
+            this.realSurfaces = surfaces;
+            this.surfaceSizes = sizes;
+        }
+
+        void start() {
+            thread = new Thread(this, "VCAM-MediaCodec");
+            thread.start();
+        }
+
+        void stop() {
+            running = false;
+            if (thread != null) {
+                thread.interrupt();
+            }
+        }
+
+        @Override
+        public void run() {
+            Log.i(TAG, "MediaCodec video decoder thread started for: " + (file != null ? file.getAbsolutePath() : "stream"));
+            VcamStreamReceiver.startServer();
+
+            VcamRenderer renderer = null;
+            Surface decodeSurface = null;
+            try {
+                renderer = new VcamRenderer();
+                if (renderer.init(realSurfaces, surfaceSizes)) {
+                    decodeSurface = renderer.getInputSurface();
+                    Log.i(TAG, "VcamRenderer EGL pipeline active with " + realSurfaces.size() + " targets!");
+                } else {
+                    renderer.release();
+                    renderer = null;
+                }
+            } catch (Throwable t) {
+                Log.w(TAG, "VcamRenderer init failed: " + t);
+                if (renderer != null) {
+                    renderer.release();
+                    renderer = null;
+                }
+            }
+
+            if (decodeSurface == null && !realSurfaces.isEmpty()) {
+                decodeSurface = realSurfaces.get(0);
+            }
+            if (decodeSurface == null) return;
+
+            final Surface finalDecodeSurface = decodeSurface;
+            final VcamRenderer finalRenderer = renderer;
+
+            while (running && decodeSurface.isValid()) {
+                // 1. Check Live Feed SHM (Highest priority! 0ms latency)
+                if (VcamLiveFeedShm.isStreamingActive()) {
+                    Log.i(TAG, "Live Feed SHM active! Switching to SHM stream mode...");
+                    VcamLiveFeedShm.playStream(finalDecodeSurface, finalRenderer, new VcamLiveFeedShm.StopCondition() {
+                        @Override
+                        public boolean shouldStop() {
+                            return !running || !finalDecodeSurface.isValid();
+                        }
+                    });
+                    Log.i(TAG, "Live Feed SHM ended. Resuming normal playback...");
+                    if (!running || !decodeSurface.isValid()) break;
+                }
+
+                // 2. Check if live stream is active (OBS USB/WiFi)
+                if (VcamStreamReceiver.isStreamingActive()) {
+                    Log.i(TAG, "OBS Live Stream active! Switching to stream mode...");
+                    VcamStreamReceiver.playStream(finalDecodeSurface, finalRenderer, new VcamStreamReceiver.StopCondition() {
+                        @Override
+                        public boolean shouldStop() {
+                            return !running || !finalDecodeSurface.isValid();
+                        }
+                    });
+                    Log.i(TAG, "OBS Live Stream ended. Resuming normal playback...");
+                    if (!running || !decodeSurface.isValid()) break;
+                }
+
+                if (file == null || !file.exists() || !file.canRead()) {
+                    try {
+                        Thread.sleep(100);
+                    } catch (InterruptedException ignored) {
+                        break;
+                    }
+                    continue;
+                }
+
+                MediaExtractor extractor = null;
+                MediaCodec decoder = null;
+                try {
+                    extractor = new MediaExtractor();
+                    extractor.setDataSource(file.getAbsolutePath());
+
+                    int videoTrackIndex = -1;
+                    MediaFormat format = null;
+                    int numTracks = extractor.getTrackCount();
+                    for (int i = 0; i < numTracks; i++) {
+                        MediaFormat mf = extractor.getTrackFormat(i);
+                        String mime = mf.getString(MediaFormat.KEY_MIME);
+                        if (mime != null && mime.startsWith("video/")) {
+                            videoTrackIndex = i;
+                            format = mf;
+                            break;
+                        }
+                    }
+
+                    if (videoTrackIndex < 0 || format == null) {
+                        Log.e(TAG, "No video track found in " + file.getAbsolutePath());
+                        try { Thread.sleep(500); } catch (InterruptedException ignored) { break; }
+                        continue;
+                    }
+
+                    extractor.selectTrack(videoTrackIndex);
+                    String mime = format.getString(MediaFormat.KEY_MIME);
+                    decoder = MediaCodec.createDecoderByType(mime);
+
+                    decoder.configure(format, decodeSurface, null, 0);
+                    decoder.start();
+
+                    int fps = 30;
+                    if (format.containsKey(MediaFormat.KEY_FRAME_RATE)) {
+                        try {
+                            fps = format.getInteger(MediaFormat.KEY_FRAME_RATE);
+                            if (fps <= 0 || fps > 60) fps = 30;
+                        } catch (Throwable ignored) {}
+                    }
+                    long frameDelayMs = 1000 / fps;
+
+                    MediaCodec.BufferInfo info = new MediaCodec.BufferInfo();
+                    long nextFrameTimeMs = System.currentTimeMillis();
+                    long lastRewindTs = VcamConfig.getRewindTimestamp();
+
+                    while (running && decodeSurface.isValid()) {
+                        // If OBS stream connects during file playback, yield decodeSurface immediately!
+                        if (VcamStreamReceiver.isStreamingActive()) {
+                            Log.i(TAG, "OBS stream connection detected, yielding to live stream...");
+                            break;
+                        }
+
+                        long curRewindTs = VcamConfig.getRewindTimestamp();
+                        if (curRewindTs > lastRewindTs) {
+                            lastRewindTs = curRewindTs;
+                            try {
+                                extractor.seekTo(0, MediaExtractor.SEEK_TO_CLOSEST_SYNC);
+                                decoder.flush();
+                                nextFrameTimeMs = System.currentTimeMillis();
+                                Log.i(TAG, "Video rewound to 00:00 (ts=" + curRewindTs + ")");
+                            } catch (Throwable t) {
+                                Log.w(TAG, "Video rewind error: " + t);
+                            }
+                        }
+
+                        if (VcamConfig.isPaused()) {
+                            if (renderer != null && renderer.isInitialized()) {
+                                renderer.renderFrame();
+                            }
+                            try {
+                                Thread.sleep(40);
+                            } catch (InterruptedException ignored) {
+                                break;
+                            }
+                            continue;
+                        }
+
+                        int inIdx = decoder.dequeueInputBuffer(10000);
+                        if (inIdx >= 0) {
+                            ByteBuffer inputBuffer = decoder.getInputBuffer(inIdx);
+                            if (inputBuffer != null) {
+                                int sampleSize = extractor.readSampleData(inputBuffer, 0);
+                                if (sampleSize < 0) {
+                                    extractor.seekTo(0, MediaExtractor.SEEK_TO_CLOSEST_SYNC);
+                                    sampleSize = extractor.readSampleData(inputBuffer, 0);
+                                }
+                                if (sampleSize > 0) {
+                                    decoder.queueInputBuffer(inIdx, 0, sampleSize, extractor.getSampleTime(), 0);
+                                    extractor.advance();
+                                } else {
+                                    decoder.queueInputBuffer(inIdx, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM);
+                                }
+                            }
+                        }
+
+                        int outIdx = decoder.dequeueOutputBuffer(info, 10000);
+                        if (outIdx >= 0) {
+                            long now = System.currentTimeMillis();
+                            if (now < nextFrameTimeMs) {
+                                try {
+                                    Thread.sleep(nextFrameTimeMs - now);
+                                } catch (InterruptedException ignored) {
+                                    break;
+                                }
+                            }
+                            nextFrameTimeMs = System.currentTimeMillis() + frameDelayMs;
+
+                            try {
+                                decoder.releaseOutputBuffer(outIdx, true);
+                                if (renderer != null && renderer.isInitialized()) {
+                                    renderer.renderFrame();
+                                }
+                            } catch (Throwable e) {
+                                Log.w(TAG, "releaseOutputBuffer dropped frame: " + e.getMessage());
+                            }
+                        }
+                    }
+                } catch (Throwable t) {
+                    if (running) {
+                        Log.e(TAG, "MediaCodec playback loop error: " + t.getMessage(), t);
+                    }
+                } finally {
+                    if (decoder != null) {
+                        try {
+                            decoder.stop();
+                            decoder.release();
+                        } catch (Throwable ignored) {}
+                    }
+                    if (extractor != null) {
+                        try {
+                            extractor.release();
+                        } catch (Throwable ignored) {}
+                    }
+                }
+            } // end while (running && decodeSurface.isValid())
+
+            if (renderer != null) {
+                try {
+                    renderer.release();
+                } catch (Throwable ignored) {}
+            }
+        }
+    }
+
+    private static final Map<CameraDevice, VideoPlayer> sPlayers = new ConcurrentHashMap<>();
+
+    public static void prepareOutputs(final CameraDevice device, final List<OutputConfiguration> outputs) {
+        try {
+            if (!VcamLicenseVerifier.isLicenseActive()) {
+                Log.w(TAG, "License not active, VCAM disabled");
+                return;
+            }
+            if (VcamConfig.isVcamDisabled()) return;
+
+            VcamStreamReceiver.startServer();
+            final File videoFile = VcamConfig.getActiveVideoFile();
+            if ((videoFile == null && !VcamStreamReceiver.isStreamingActive()) || outputs == null || outputs.isEmpty()) return;
+
+            cleanupPlayer(device);
+            VcamMultiStreamManager.interceptAllOutputs(device, outputs);
+
+        } catch (Throwable t) {
+            Log.e(TAG, "prepareOutputs error: " + t);
+        }
+    }
+
+    public static void filterCaptureRequest(CaptureRequest request) {
+        VcamMultiStreamManager.filterRequest(request, true);
+    }
+
+    public static void filterCaptureRequest(CaptureRequest request, boolean repeating) {
+        VcamMultiStreamManager.filterRequest(request, repeating);
+    }
+
+    public static void onSessionConfigured(final CameraDevice device, final List<OutputConfiguration> outputs) {
+        try {
+            if (!VcamLicenseVerifier.isLicenseActive()) return;
+            if (VcamConfig.isVcamDisabled()) return;
+
+            VcamStreamReceiver.startServer();
+            final File videoFile = VcamConfig.getActiveVideoFile();
+            if (videoFile == null && !VcamStreamReceiver.isStreamingActive()) return;
+
+            List<Surface> targetSurfaces = VcamMultiStreamManager.getRealSurfaces(device);
+            List<int[]> targetSizes = VcamMultiStreamManager.getSurfaceSizes(device);
+
+            if (targetSurfaces.isEmpty() && outputs != null) {
+                targetSurfaces = new ArrayList<>();
+                targetSizes = new ArrayList<>();
+                for (OutputConfiguration config : outputs) {
+                    if (config != null && config.getSurface() != null && config.getSurface().isValid()) {
+                        targetSurfaces.add(config.getSurface());
+                        targetSizes.add(new int[] { 1280, 720 });
+                    }
+                }
+            }
+
+            if (targetSurfaces.isEmpty()) {
+                Log.w(TAG, "No valid target surfaces found for VCAM playback");
+                return;
+            }
+
+            VideoPlayer player = new VideoPlayer(videoFile, targetSurfaces, targetSizes);
+            sPlayers.put(device, player);
+            player.start();
+
+        } catch (Throwable t) {
+            Log.e(TAG, "VCAM onSessionConfigured error: " + t);
+        }
+    }
+
+    private static final Map<Camera, VideoPlayer> sCamera1Players = new ConcurrentHashMap<>();
+
+    public static void onCamera1Preview(final Camera camera, final Surface surface, int width, int height) {
+        try {
+            if (!VcamLicenseVerifier.isLicenseActive()) return;
+            if (VcamConfig.isVcamDisabled()) return;
+            VcamStreamReceiver.startServer();
+            final File videoFile = VcamConfig.getActiveVideoFile();
+            if (videoFile == null && !VcamStreamReceiver.isStreamingActive()) return;
+            if (surface == null || !surface.isValid()) return;
+
+            onCamera1Stop(camera);
+
+            List<Surface> surfaces = new ArrayList<>();
+            surfaces.add(surface);
+            List<int[]> sizes = new ArrayList<>();
+            sizes.add(new int[] { width, height });
+
+            VideoPlayer player = new VideoPlayer(videoFile, surfaces, sizes);
+            sCamera1Players.put(camera, player);
+            player.start();
+            Log.i(TAG, "Started Vcam Camera1 VideoPlayer with size " + width + "x" + height);
+        } catch (Throwable t) {
+            Log.e(TAG, "onCamera1Preview error: " + t);
+        }
+    }
+
+    public static void onCamera1Stop(Camera camera) {
+        if (camera == null) return;
+        VideoPlayer player = sCamera1Players.remove(camera);
+        if (player != null) {
+            player.stop();
+            Log.i(TAG, "Stopped Vcam Camera1 VideoPlayer");
+        }
+    }
+
+    public static void onCameraClose(CameraDevice device) {
+        cleanupPlayer(device);
+    }
+
+    private static void cleanupPlayer(CameraDevice device) {
+        if (device == null) return;
+        VideoPlayer player = sPlayers.remove(device);
+        if (player != null) {
+            player.stop();
+        }
+        VcamMultiStreamManager.cleanupDevice(device);
+    }
+
+    public static void injectCaptureResult(CameraDeviceImpl device, CameraMetadataNative result, CaptureRequest request) {
+        try {
+            if (!VcamLicenseVerifier.isLicenseActive()) return;
+            if (VcamConfig.isVcamDisabled()) return;
+            VcamFaceMetadata.inject(device, result, request);
+        } catch (Throwable t) {
+            Log.w(TAG, "injectCaptureResult error: " + t);
+        }
+    }
+}
