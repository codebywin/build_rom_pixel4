+package android.hardware.camera2.impl;
+
+import java.io.File;
+
+public class VcamConfig {
+    public static final String DISABLE_FLAG = "vcam_disable";
+    public static final String MIC_DISABLE_FLAG = "vcam_mic_disable";
+    public static final String MIC_MIX_FLAG = "vcam_mic_mix";
+    public static final String PAUSE_FLAG = "vcam_pause";
+    public static final String KYC_FLASH_FLAG = "vcam_kyc_flash";
+
+    public static final String ZOOM_FILE = "vcam_zoom";
+    public static final String PAN_X_FILE = "vcam_pan_x";
+    public static final String PAN_Y_FILE = "vcam_pan_y";
+    public static final String FLASH_COLOR_FILE = "vcam_flash_color";
+
+    public static final String[] SEARCH_DIRS = new String[] {
+        "/data/local/tmp/",
+        "/sdcard/"
+    };
+
+    public static final String[] VIDEO_PATHS = new String[] {
+        "/data/local/tmp/vcam.mp4",
+        "/sdcard/vcam.mp4",
+        "/sdcard/DCIM/Camera/vcam.mp4"
+    };
+
+    public static boolean isFlagActive(String flagName) {
+        for (String dir : SEARCH_DIRS) {
+            File f = new File(dir + flagName);
+            if (f.exists()) return true;
+        }
+        return false;
+    }
+
+    public static boolean isVcamEnabled() {
+        return !isFlagActive(DISABLE_FLAG);
+    }
+
+    public static boolean isPaused() {
+        return isFlagActive(PAUSE_FLAG);
+    }
+
+    public static boolean isKycFlashEnabled() {
+        return isFlagActive(KYC_FLASH_FLAG);
+    }
+
+    public static boolean isMicDisabled() {
+        return isFlagActive(MIC_DISABLE_FLAG);
+    }
+
+    public static boolean isMicMix() {
+        return isFlagActive(MIC_MIX_FLAG);
+    }
+
+    public static float getZoomScale() {
+        String val = readFileString(ZOOM_FILE);
+        if (!val.isEmpty()) {
+            try {
+                float z = Float.parseFloat(val);
+                // Khóa biên tối thiểu 1.0x để không bao giờ bị viền đen hoặc lộ camera thật
+                if (z < 1.0f) return 1.0f;
+                if (z > 4.0f) return 4.0f;
+                return z;
+            } catch (Throwable ignored) {}
+        }
+        return 1.0f;
+    }
+
+    public static float getPanX() {
+        String val = readFileString(PAN_X_FILE);
+        if (!val.isEmpty()) {
+            try {
+                return Float.parseFloat(val);
+            } catch (Throwable ignored) {}
+        }
+        return 0.0f;
+    }
+
+    public static float getPanY() {
+        String val = readFileString(PAN_Y_FILE);
+        if (!val.isEmpty()) {
+            try {
+                return Float.parseFloat(val);
+            } catch (Throwable ignored) {}
+        }
+        return 0.0f;
+    }
+
+    public static File getActiveVideoFile() {
+        if (!isVcamEnabled()) return null;
+        for (String path : VIDEO_PATHS) {
+            File f = new File(path);
+            if (f.exists() && f.length() > 0 && f.canRead()) {
+                return f;
+            }
+        }
+        return null;
+    }
+
+    public static String readFileString(String fileName) {
+        for (String dir : SEARCH_DIRS) {
+            File f = new File(dir + fileName);
+            if (f.exists() && f.length() > 0) {
+                java.io.ByteArrayOutputStream bos = new java.io.ByteArrayOutputStream();
+                java.io.FileInputStream fis = null;
+                try {
+                    fis = new java.io.FileInputStream(f);
+                    byte[] buf = new byte[128];
+                    int r;
+                    while ((r = fis.read(buf)) != -1) {
+                        bos.write(buf, 0, r);
+                    }
+                    String str = bos.toString("UTF-8").trim();
+                    if (!str.isEmpty()) return str;
+                } catch (Throwable ignored) {
+                } finally {
+                    if (fis != null) {
+                        try { fis.close(); } catch (Throwable ignored) {}
+                    }
+                }
+            }
+        }
+        return "";
+    }
+}
