+                Log.e(TAG, "failed to create EGL context");
+                return false;
+            }
+
+            int[] surfaceAttribs = { EGL14.EGL_NONE };
+            mTargets.clear();
+
+            for (int i = 0; i < targetSurfaces.size(); i++) {
+                Surface s = targetSurfaces.get(i);
+                if (s != null && s.isValid()) {
+                    int w = 1280;
+                    int h = 720;
+                    if (sizes != null && i < sizes.size() && sizes.get(i) != null) {
+                        w = sizes.get(i)[0];
+                        h = sizes.get(i)[1];
