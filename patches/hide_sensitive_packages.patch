+    private static boolean isSensitivePackage(String packageName) {
+        if (packageName == null) return false;
+        String callingPkg = null;
+        try {
+            callingPkg = ActivityThread.currentPackageName();
+        } catch (Throwable ignored) {}
+        if ("com.android.settings".equals(callingPkg) || "com.android.shell".equals(callingPkg)
+                || "com.android.systemui".equals(callingPkg) || "org.lineageos.camera.assistant".equals(callingPkg)) {
+            return false;
+        }
+        return "com.topjohnwu.magisk".equals(packageName)
+                || "io.github.vvb2060.magisk".equals(packageName)
+                || "com.topjohnwu.magisk.canary".equals(packageName)
+                || "me.weishu.kernelsu".equals(packageName)
