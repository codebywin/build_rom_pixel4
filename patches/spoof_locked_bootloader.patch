diff --git a/core/java/android/os/SystemProperties.java b/core/java/android/os/SystemProperties.java
--- a/core/java/android/os/SystemProperties.java
+++ b/core/java/android/os/SystemProperties.java
@@ -17,6 +17,7 @@
 package android.os;
 
 import android.annotation.NonNull;
+import android.os.Process;
 import android.annotation.Nullable;
 import android.annotation.SystemApi;
 import android.compat.annotation.UnsupportedAppUsage;
@@ -146,6 +147,8 @@
     @SystemApi
     public static String get(@NonNull String key) {
         if (TRACK_KEY_ACCESS) onKeyAccess(key);
+        String spoofed = spoofProperty(key);
+        if (spoofed != null) return spoofed;
         return native_get(key);
     }
 
@@ -162,6 +165,8 @@
     @SystemApi
     public static String get(@NonNull String key, @Nullable String def) {
         if (TRACK_KEY_ACCESS) onKeyAccess(key);
+        String spoofed = spoofProperty(key);
+        if (spoofed != null) return spoofed;
         return native_get(key, def);
     }
 
@@ -177,6 +182,12 @@
     @SystemApi
     public static int getInt(@NonNull String key, int def) {
         if (TRACK_KEY_ACCESS) onKeyAccess(key);
+        if (isCallerApp()) {
+            if ("ro.boot.flash.locked".equals(key)) return 1;
+            if ("ro.debuggable".equals(key)) return 0;
+            if ("ro.secure".equals(key)) return 1;
+            if ("service.adb.tcp.port".equals(key)) return -1;
+        }
         return native_get_int(key, def);
     }
 
@@ -212,6 +223,11 @@
     @SystemApi
     public static boolean getBoolean(@NonNull String key, boolean def) {
         if (TRACK_KEY_ACCESS) onKeyAccess(key);
+        if (isCallerApp()) {
+            if ("ro.boot.flash.locked".equals(key)) return true;
+            if ("ro.debuggable".equals(key)) return false;
+            if ("ro.secure".equals(key)) return true;
+        }
         return native_get_boolean(key, def);
     }
 
@@ -382,4 +398,52 @@
             mNativeHandle = nativeHandle;
         }
     }
+
+    private static boolean isCallerApp() {
+        try {
+            return Process.myUid() >= Process.FIRST_APPLICATION_UID;
+        } catch (Throwable ignored) {
+            return false;
+        }
+    }
+
+    private static String spoofProperty(String key) {
+        if (!isCallerApp()) return null;
+
+        if ("ro.boot.flash.locked".equals(key)) return "1";
+        if ("ro.boot.verifiedbootstate".equals(key)) return "green";
+        if ("ro.boot.vbmeta.device_state".equals(key)) return "locked";
+        if ("ro.boot.veritymode".equals(key)) return "enforcing";
+        if ("ro.build.tags".equals(key)) return "release-keys";
+        if ("ro.build.type".equals(key)) return "user";
+        if ("ro.debuggable".equals(key)) return "0";
+        if ("ro.secure".equals(key)) return "1";
+        if ("init.svc.adbd".equals(key)) return "stopped";
+        if ("persist.sys.usb.config".equals(key) || "sys.usb.config".equals(key) || "sys.usb.state".equals(key)) return "none";
+        if ("service.adb.tcp.port".equals(key) || "service.adb.listen_type".equals(key)) return "-1";
+
+        if (key != null && (key.startsWith("ro.lineage.") || key.startsWith("ro.modversion") || key.startsWith("ro.cm."))) {
+            return "";
+        }
+
+        boolean isCoral = "coral".equals(native_get("ro.product.device")) || "coral".equals(native_get("ro.build.product"));
+        if ("ro.build.fingerprint".equals(key) || "ro.bootimage.build.fingerprint".equals(key)
+                || "ro.system.build.fingerprint".equals(key) || "ro.vendor.build.fingerprint".equals(key)) {
+            return isCoral ? "google/coral/coral:13/TP1A.221005.002/8866180:user/release-keys"
+                           : "google/flame/flame:13/TP1A.221005.002.B2/9382335:user/release-keys";
+        }
+        if ("ro.build.id".equals(key) || "ro.build.display.id".equals(key)) {
+            return isCoral ? "TP1A.221005.002" : "TP1A.221005.002.B2";
+        }
+        if ("ro.product.brand".equals(key) || "ro.product.system.brand".equals(key) || "ro.product.vendor.brand".equals(key)) return "google";
+        if ("ro.product.manufacturer".equals(key) || "ro.product.system.manufacturer".equals(key)) return "Google";
+        if ("ro.product.model".equals(key) || "ro.product.system.model".equals(key) || "ro.product.vendor.model".equals(key)) {
+            return isCoral ? "Pixel 4 XL" : "Pixel 4";
+        }
+        if ("ro.build.version.security_patch".equals(key)) {
+            return "2022-10-05";
+        }
+        return null;
+    }
+
 }
