# Auto detect text files and perform LF normalization
* text=auto

# Linux scripts must always be LF
*.sh text eol=lf
*.patch text eol=lf
*.xml text eol=lf
*.bp text eol=lf
*.rc text eol=lf
*.te text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf
